// Directed arrival-boundary regression: reverse/add chains keep arithmetic inputs late.
package arrival_properties
top fn f(a: bits[4] id=1, b: bits[2] id=2, c: bits[5] id=3, d: bits[5] id=4, s: bits[2] id=5) -> bits[5] {
  v6: bits[4] = reverse(a, id=6)
  v7: bits[4] = add(v6, a, id=7)
  v8: bits[4] = reverse(v7, id=8)
  v9: bits[4] = add(v8, a, id=9)
  v10: bits[4] = reverse(v9, id=10)
  v11: bits[4] = add(v10, a, id=11)
  v12: bits[4] = reverse(v11, id=12)
  v13: bits[4] = add(v12, a, id=13)
  v14: bits[4] = reverse(v13, id=14)
  v15: bits[4] = add(v14, a, id=15)
  v16: bits[4] = reverse(v15, id=16)
  v17: bits[4] = add(v16, a, id=17)
  v18: bits[4] = reverse(v17, id=18)
  v19: bits[4] = add(v18, a, id=19)
  v20: bits[4] = reverse(v19, id=20)
  v21: bits[4] = add(v20, a, id=21)
  v22: bits[4] = reverse(v21, id=22)
  v23: bits[4] = add(v22, a, id=23)
  v24: bits[4] = reverse(v23, id=24)
  v25: bits[4] = add(v24, a, id=25)
  v26: bits[4] = reverse(v25, id=26)
  v27: bits[4] = add(v26, a, id=27)
  v28: bits[4] = reverse(v27, id=28)
  v29: bits[4] = add(v28, a, id=29)
  p: bits[5] = smul(v29, b, id=30)
  ret r: bits[5] = ext_nary_add(p, c, d, signed=[true, false, false], negated=[true, false, false], arch=kogge_stone, id=31)
}
