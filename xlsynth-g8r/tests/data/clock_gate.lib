library (clock_gate_test) {
  time_unit: "1ns";
  voltage_unit: "1V";
  capacitive_load_unit (1,pf);
  nom_voltage: 1;
  lu_table_template (slew) {
    variable_1: input_net_transition;
    index_1 ("1,2,4,8");
  }
  cell (BUF) {
    area: 1;
    pin (A) { direction: input; }
    pin (Y) { direction: output; function: "A"; }
  }
  cell (DFF) {
    area: 2;
    ff (IQ, IQN) {
      clocked_on: "CLK";
      next_state: "D";
    }
    pin (CLK) {
      direction: input;
      clock: true;
      capacitance: 4;
      internal_power () { power (scalar) { values ("5"); } }
    }
    pin (D) { direction: input; }
    pin (Q) {
      direction: output;
      function: "IQ";
      timing () {
        related_pin: "CLK";
        timing_type: rising_edge;
        rise_transition (slew) { values ("1,1,6,6"); }
        fall_transition (slew) { values ("1,1,6,6"); }
      }
      internal_power () {
        related_pin: "CLK";
        power (scalar) { values ("11"); }
      }
    }
  }
  cell (AND2) {
    area: 1;
    pin (A) { direction: input; }
    pin (B) { direction: input; }
    pin (Y) { direction: output; function: "A & B"; }
  }
  cell (INV) {
    area: 1;
    pin (A) { direction: input; }
    pin (Y) { direction: output; function: "!A"; }
  }
  cell (MUX2) {
    area: 2;
    pin (S) { direction: input; }
    pin (A) { direction: input; }
    pin (B) { direction: input; }
    pin (Y) { direction: output; function: "(!S & A) | (S & B)"; }
  }
  cell (ICG) {
    area: 2;
    clock_gating_integrated_cell: latch_posedge_precontrol;
    statetable ("CLK ENA SE", "IQ") {
      table: "L L L : - : L, L L H : - : H, L H L : - : H, L H H : - : H, H - - : - : N";
    }
    pin (IQ) { direction: internal; internal_node: "IQ"; }
    pin (CLK) {
      direction: input;
      clock: true;
      clock_gate_clock_pin: true;
      capacitance: 2;
      internal_power () { when: "!ENA"; power (scalar) { values ("1"); } }
      internal_power () { when: "ENA"; power (scalar) { values ("2"); } }
    }
    pin (ENA) {
      direction: input;
      clock_gate_enable_pin: true;
      capacitance: 2;
      internal_power () { power (scalar) { values ("7"); } }
    }
    pin (SE) { direction: input; clock_gate_test_pin: true; }
    pin (GCLK) {
      direction: output;
      clock_gate_out_pin: true;
      state_function: "CLK & IQ";
      timing () {
        related_pin: "CLK";
        timing_sense: positive_unate;
        rise_transition (scalar) { values ("8"); }
        fall_transition (scalar) { values ("8"); }
      }
      internal_power () {
        related_pin: "CLK";
        power (scalar) { values ("3"); }
      }
    }
  }
}
