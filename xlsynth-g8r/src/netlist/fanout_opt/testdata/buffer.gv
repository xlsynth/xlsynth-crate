module top(a, o0, o1, o2, o3, z);
  input a;
  output o0;
  output o1;
  output o2;
  output o3;
  output z;
  wire n;
  wire \alias ;
  wire tied;
  wire ain;
  wire fanout_opt_23;
  wire fanout_opt_24;
  wire fanout_opt_26;
  assign ain = a;
  assign tied = 1'b0;
  assign \alias  = n;
  assign z = n;
  DRIVE drv (.B(tied), .Y(n), .A(ain));
  LOAD s0 (.Y(o0), .U(), .A(fanout_opt_24));
  LOAD s1 (.Y(o1), .U(), .A(fanout_opt_26));
  LOAD s2 (.Y(o2), .U(), .A(fanout_opt_24));
  LOAD s3 (.Y(o3), .U(), .A(fanout_opt_26));
  BUF fanout_opt_25 (.A(n), .Y(fanout_opt_24));
  BUF fanout_opt_27 (.A(n), .Y(fanout_opt_26));
endmodule
