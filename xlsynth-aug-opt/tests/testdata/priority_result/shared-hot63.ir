package nextpow2
top fn main(x: bits[63] id=1) -> (bits[63],bits[64]) {
  one: bits[63] = literal(value=1,id=2)
  y: bits[63] = sub(x,one,id=3)
  r: bits[63] = reverse(y,id=4)
  h: bits[64] = one_hot(r,lsb_prio=true,id=5)
  n: bits[6] = encode(h,id=6)
  nw: bits[63] = zero_ext(n,new_bit_count=63,id=7)
  size: bits[63] = literal(value=63,id=8)
  difference: bits[63] = sub(size,nw,id=9)
  zero: bits[63] = literal(value=0,id=10)
  nz: bits[1] = ne(x,zero,id=11)
  mask: bits[63] = sign_ext(nz,new_bit_count=63,id=12)
  k: bits[63] = and(difference,mask,id=13)
  result: bits[63] = shll(one,k,id=14)
  ret out: (bits[63],bits[64]) = tuple(result,h,id=15)
}
