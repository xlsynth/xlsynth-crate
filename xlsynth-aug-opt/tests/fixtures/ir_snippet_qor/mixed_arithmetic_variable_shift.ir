package synthetic

// DSLX expression:
//   {
//     let n0 = z & y;
//     let n1 = n0 - y;
//     let n2 = n1 + n0;
//     let n3 = n2 ^ z;
//     let n4 = n3 - y;
//     (n4 << n0) ^ y
//   }
top fn main(y: bits[4] id=10, z: bits[4] id=11) -> bits[4] {
  n0: bits[4] = and(z, y, id=12)
  n1: bits[4] = sub(n0, y, id=13)
  n2: bits[4] = add(n1, n0, id=14)
  n3: bits[4] = xor(n2, z, id=15)
  n4: bits[4] = sub(n3, y, id=16)
  n5: bits[4] = shll(n4, n0, id=17)
  ret result: bits[4] = xor(n5, y, id=18)
}
