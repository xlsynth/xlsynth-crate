// Origin: Synthetic count-predicate n8-low1-add-or_slice-share-count
// Original source SHA256: 4e0296ba23cf63c3fc536ad569c36afa56d5297bde854283e07669000dfbf9cf
package synth
top fn main(x: bits[8] id=1) -> (bits[1], bits[4]) {
  hot: bits[9] = one_hot(x, lsb_prio=true, id=2)
  count: bits[4] = encode(hot, id=3)
  k: bits[4] = literal(value=1, id=5)
  amount0: bits[4] = add(k, count, id=6)
  view: bits[3] = bit_slice(amount0, start=1, width=3, id=8)
  out: bits[1] = or_reduce(view, id=9)
  ret pair: (bits[1], bits[4]) = tuple(out, count, id=10)
}
