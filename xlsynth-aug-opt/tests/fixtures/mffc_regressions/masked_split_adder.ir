package mffc_regression

// Split five-bit addition with constructed operands and a nonzero validity mask.
// Inputs: p0 and p1 are u4; p2 through p11 are u1; p12 and p13 are u7.
// DSLX expression:
//   {
//     let x_mask: u5 = if !(p3 | p6 | p2) { u5:31 } else { u5:0 };
//     let y_mask: u5 = if !(p9 | p10 | p11) { u5:31 } else { u5:0 };
//     let x: u5 = (u1:0 ++ p1) | ((u4:15 ++ (p4 | p5)) & x_mask);
//     let y: u5 = (u1:0 ++ p0) | ((u4:15 ++ (p7 | p8)) & y_mask);
//     let low: u1 = x[0:1] ^ y[0:1];
//     let carry: u4 = (x[0:1] & y[0:1]) as u4;
//     let high: u4 = x[1:5] + y[1:5] + carry;
//     let sum: u5 = high ++ low;
//     let valid: u1 = !((p12 == u7:0) | (p13 == u7:0));
//     sum & (if valid { u5:31 } else { u5:0 })
//   }
top fn main(p0: bits[4] id=1, p1: bits[4] id=2, p2: bits[1] id=3, p3: bits[1] id=4, p4: bits[1] id=5, p5: bits[1] id=6, p6: bits[1] id=7, p7: bits[1] id=8, p8: bits[1] id=9, p9: bits[1] id=10, p10: bits[1] id=11, p11: bits[1] id=12, p12: bits[7] id=13, p13: bits[7] id=14) -> bits[5] {
  literal.15: bits[3] = literal(value=0, id=15)
  literal.16: bits[4] = literal(value=15, id=16)
  or.17: bits[1] = or(p4, p5, id=17)
  nor.18: bits[1] = nor(p3, p6, p2, id=18)
  or.19: bits[1] = or(p7, p8, id=19)
  nor.20: bits[1] = nor(p9, p10, p11, id=20)
  literal.21: bits[1] = literal(value=0, id=21)
  concat.22: bits[5] = concat(literal.16, or.17, id=22)
  sign_ext.23: bits[5] = sign_ext(nor.18, new_bit_count=5, id=23)
  concat.24: bits[5] = concat(literal.16, or.19, id=24)
  sign_ext.25: bits[5] = sign_ext(nor.20, new_bit_count=5, id=25)
  concat.26: bits[5] = concat(literal.21, p1, id=26)
  and.27: bits[5] = and(concat.22, sign_ext.23, id=27)
  concat.28: bits[5] = concat(literal.21, p0, id=28)
  and.29: bits[5] = and(concat.24, sign_ext.25, id=29)
  or.30: bits[5] = or(concat.26, and.27, id=30)
  or.31: bits[5] = or(concat.28, and.29, id=31)
  bit_slice.32: bits[1] = bit_slice(or.30, start=0, width=1, id=32)
  bit_slice.33: bits[1] = bit_slice(or.31, start=0, width=1, id=33)
  bit_slice.34: bits[4] = bit_slice(or.30, start=1, width=4, id=34)
  bit_slice.35: bits[4] = bit_slice(or.31, start=1, width=4, id=35)
  and.36: bits[1] = and(bit_slice.32, bit_slice.33, id=36)
  literal.37: bits[7] = literal(value=0, id=37)
  add.38: bits[4] = add(bit_slice.34, bit_slice.35, id=38)
  concat.39: bits[4] = concat(literal.15, and.36, id=39)
  eq.40: bits[1] = eq(p12, literal.37, id=40)
  eq.41: bits[1] = eq(p13, literal.37, id=41)
  add.42: bits[4] = add(add.38, concat.39, id=42)
  xor.43: bits[1] = xor(bit_slice.32, bit_slice.33, id=43)
  nor.44: bits[1] = nor(eq.40, eq.41, id=44)
  concat.45: bits[5] = concat(add.42, xor.43, id=45)
  sign_ext.46: bits[5] = sign_ext(nor.44, new_bit_count=5, id=46)
  ret and.47: bits[5] = and(concat.45, sign_ext.46, id=47)
}
