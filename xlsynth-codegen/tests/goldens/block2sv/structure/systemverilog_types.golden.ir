package typed_port_package

top block typed_ports(input_data: bits[8], output_data: bits[8]) {
  input_data: bits[8] = input_port(name=input_data, sv_type="types::input_t", id=1)
  output_data: () = output_port(input_data, name=output_data, sv_type="types::output_t", id=2)
}

// OPTIONS: emit_sv_types = true
// EXPECT-SV: module typed_ports(
// EXPECT-SV:   input types::input_t input_data,
// EXPECT-SV:   output types::output_t output_data
// EXPECT-SV: );
// EXPECT-SV:   assign output_data = input_data;
// EXPECT-SV: endmodule
