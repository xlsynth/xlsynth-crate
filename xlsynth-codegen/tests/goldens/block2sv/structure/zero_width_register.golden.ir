package zero_width_register_package

top block zero_width_register(clk: clock, data: bits[8], out: bits[8]) {
  reg empty_state(bits[0])
  data: bits[8] = input_port(name=data, id=1)
  empty: bits[0] = literal(value=0, id=2)
  state_q: bits[0] = register_read(register=empty_state, id=3)
  state_d: () = register_write(empty, register=empty_state, id=4)
  out: () = output_port(data, name=out, id=5)
}

