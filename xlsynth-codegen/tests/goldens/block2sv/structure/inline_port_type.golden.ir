package inline_port_type

top block inline_port_type(data: bits[8], result: bits[8]) {
  data: bits[8] = input_port(name=data, sv_type="logic [7:0]", id=1)
  not.2: bits[8] = not(data, id=2)
  result: () = output_port(not.2, name=result, sv_type="logic [7:0]", id=3)
}

// EXPECT-SV: module inline_port_type(
// EXPECT-SV:   input logic [7:0] data,
// EXPECT-SV:   output logic [7:0] result
// EXPECT-SV: );
// EXPECT-SV:   logic [7:0] data__1;
// EXPECT-SV:   assign data__1 = data;
// EXPECT-SV:   assign result = ~data__1;
// EXPECT-SV: endmodule
