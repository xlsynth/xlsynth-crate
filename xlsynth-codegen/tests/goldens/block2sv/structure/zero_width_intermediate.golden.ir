package zero_width_intermediate_package

top block zero_width_intermediate(data: bits[8], out: bits[8]) {
  data: bits[8] = input_port(name=data, id=1)
  empty: bits[0] = literal(value=0, id=2)
  combined: bits[8] = concat(empty, data, id=3)
  out: () = output_port(combined, name=out, id=4)
}

// OPTIONS: # BlockCodegenOptions defaults
// EXPECT-SV: module zero_width_intermediate(
// EXPECT-SV:   input logic [7:0] data,
// EXPECT-SV:   output logic [7:0] out
// EXPECT-SV: );
// EXPECT-SV:   logic [7:0] combined;
// EXPECT-SV:   assign combined = data;
// EXPECT-SV:   assign out = combined;
// EXPECT-SV: endmodule
