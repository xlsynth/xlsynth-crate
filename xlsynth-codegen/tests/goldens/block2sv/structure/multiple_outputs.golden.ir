package multiple_output_package

top block multiple_outputs(lhs: bits[8], rhs: bits[8], sum_out: bits[8], xor_out: bits[8]) {
  lhs: bits[8] = input_port(name=lhs, id=1)
  rhs: bits[8] = input_port(name=rhs, id=2)
  sum: bits[8] = add(lhs, rhs, id=3)
  difference: bits[8] = xor(lhs, rhs, id=4)
  sum_out: () = output_port(sum, name=sum_out, id=5)
  xor_out: () = output_port(difference, name=xor_out, id=6)
}

// OPTIONS: layout = "none"
// EXPECT-SV: module multiple_outputs(
// EXPECT-SV:   input logic [7:0] lhs,
// EXPECT-SV:   input logic [7:0] rhs,
// EXPECT-SV:   output logic [7:0] sum_out,
// EXPECT-SV:   output logic [7:0] xor_out
// EXPECT-SV: );
// EXPECT-SV:   logic [7:0] sum;
// EXPECT-SV:   logic [7:0] difference;
// EXPECT-SV:   assign sum = lhs + rhs;
// EXPECT-SV:   assign difference = lhs ^ rhs;
// EXPECT-SV:   assign sum_out = sum;
// EXPECT-SV:   assign xor_out = difference;
// EXPECT-SV: endmodule
