package interleaved_port_package

top block interleaved_ports(lhs: bits[8], first: bits[8], rhs: bits[8], second: bits[8]) {
  lhs: bits[8] = input_port(name=lhs, id=1)
  first: () = output_port(lhs, name=first, id=2)
  rhs: bits[8] = input_port(name=rhs, id=3)
  second: () = output_port(rhs, name=second, id=4)
}

// OPTIONS: # BlockCodegenOptions defaults
// EXPECT-SV: module interleaved_ports(
// EXPECT-SV:   input logic [7:0] lhs,
// EXPECT-SV:   output logic [7:0] first,
// EXPECT-SV:   input logic [7:0] rhs,
// EXPECT-SV:   output logic [7:0] second
// EXPECT-SV: );
// EXPECT-SV:   assign first = lhs;
// EXPECT-SV:   assign second = rhs;
// EXPECT-SV: endmodule
