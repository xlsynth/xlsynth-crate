package empty_reductions_package

top block empty_reductions(empty: bits[0], all_set: bits[1], any_set: bits[1], odd_parity: bits[1]) {
  empty: bits[0] = input_port(name=empty, id=1)
  reduced_and: bits[1] = and_reduce(empty, id=2)
  reduced_or: bits[1] = or_reduce(empty, id=3)
  reduced_xor: bits[1] = xor_reduce(empty, id=4)
  all_set: () = output_port(reduced_and, name=all_set, id=5)
  any_set: () = output_port(reduced_or, name=any_set, id=6)
  odd_parity: () = output_port(reduced_xor, name=odd_parity, id=7)
}

