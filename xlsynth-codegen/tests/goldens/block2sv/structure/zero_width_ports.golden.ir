package zero_width_port_package

top block zero_width_ports(empty: bits[0], data: bits[8], empty_out: bits[0], out: bits[8]) {
  empty: bits[0] = input_port(name=empty, id=1)
  data: bits[8] = input_port(name=data, id=2)
  empty_out: () = output_port(empty, name=empty_out, id=3)
  out: () = output_port(data, name=out, id=4)
}

