// EXPECT-SV: module untyped_ports(
// EXPECT-SV:   input logic [7:0] input_data,
// EXPECT-SV:   output logic [7:0] output_data
// EXPECT-SV: );
// EXPECT-SV:   assign output_data = input_data;
