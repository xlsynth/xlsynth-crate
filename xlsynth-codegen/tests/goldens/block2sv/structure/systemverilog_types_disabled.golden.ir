package untyped_port_package

top block untyped_ports(input_data: bits[8], output_data: bits[8]) {
  input_data: bits[8] = input_port(name=input_data, sv_type="types::input_t", id=1)
  output_data: () = output_port(input_data, name=output_data, sv_type="types::output_t", id=2)
}

