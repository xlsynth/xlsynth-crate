package wide_literal_package

top block wide_literal(data: bits[96], out: bits[96]) {
  data: bits[96] = input_port(name=data, id=1)
  constant: bits[96] = literal(value=0x123456789abcdef012345678, id=2)
  result: bits[96] = xor(data, constant, id=3)
  out: () = output_port(result, name=out, id=4)
}

// OPTIONS: # BlockCodegenOptions defaults
// EXPECT-SV: module wide_literal(
// EXPECT-SV:   input logic [95:0] data,
// EXPECT-SV:   output logic [95:0] out
// EXPECT-SV: );
// EXPECT-SV:   logic [95:0] constant;
// EXPECT-SV:   logic [95:0] result;
// EXPECT-SV:   assign constant = 96'h1234_5678_9abc_def0_1234_5678;
// EXPECT-SV:   assign result = data ^ constant;
// EXPECT-SV:   assign out = result;
// EXPECT-SV: endmodule
