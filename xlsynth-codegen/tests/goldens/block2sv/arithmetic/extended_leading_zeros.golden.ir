package extended_leading_zeros_package

top block extended_leading_zeros(data: bits[8], out: bits[4]) {
  data: bits[8] = input_port(name=data, id=1)
  result: bits[4] = ext_clz(data, offset=1, new_bit_count=4, id=2)
  out: () = output_port(result, name=out, id=3)
}

