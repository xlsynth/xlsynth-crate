// EXPECT-SV: module one_hot_choice(
// EXPECT-SV:   input logic [2:0] selector,
// EXPECT-SV:   input logic [7:0] first,
// EXPECT-SV:   input logic [7:0] second,
// EXPECT-SV:   input logic [7:0] third,
// EXPECT-SV:   output logic [7:0] out
// EXPECT-SV: );
// EXPECT-SV:   logic [7:0] selected;
// EXPECT-SV:   assign selected = 8'h00 | (selector[0] ? first : 8'h00) | (selector[1] ? second : 8'h00) | (selector[2] ? third : 8'h00);
// EXPECT-SV:   assign out = selected;
// EXPECT-SV: endmodule
