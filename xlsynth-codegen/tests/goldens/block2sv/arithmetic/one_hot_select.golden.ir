package one_hot_select_package

top block one_hot_choice(selector: bits[3], first: bits[8], second: bits[8], third: bits[8], out: bits[8]) {
  selector: bits[3] = input_port(name=selector, id=1)
  first: bits[8] = input_port(name=first, id=2)
  second: bits[8] = input_port(name=second, id=3)
  third: bits[8] = input_port(name=third, id=4)
  selected: bits[8] = one_hot_sel(selector, cases=[first, second, third], id=5)
  out: () = output_port(selected, name=out, id=6)
}

