package signed_multiply_package

top block signed_multiply(lhs: bits[8], rhs: bits[12], out: bits[20]) {
  lhs: bits[8] = input_port(name=lhs, id=1)
  rhs: bits[12] = input_port(name=rhs, id=2)
  product: bits[20] = smul(lhs, rhs, id=3)
  out: () = output_port(product, name=out, id=4)
}

