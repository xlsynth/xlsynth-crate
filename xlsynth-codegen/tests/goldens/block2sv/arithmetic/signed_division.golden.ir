package signed_division_package

top block signed_division(lhs: bits[16], rhs: bits[16], quotient: bits[16], remainder: bits[16]) {
  lhs: bits[16] = input_port(name=lhs, id=1)
  rhs: bits[16] = input_port(name=rhs, id=2)
  divided: bits[16] = sdiv(lhs, rhs, id=3)
  residue: bits[16] = smod(lhs, rhs, id=4)
  quotient: () = output_port(divided, name=quotient, id=5)
  remainder: () = output_port(residue, name=remainder, id=6)
}

// OPTIONS: # BlockCodegenOptions defaults
// EXPECT-SV: module signed_division(
// EXPECT-SV:   input logic [15:0] lhs,
// EXPECT-SV:   input logic [15:0] rhs,
// EXPECT-SV:   output logic [15:0] quotient,
// EXPECT-SV:   output logic [15:0] remainder
// EXPECT-SV: );
// EXPECT-SV:   function automatic logic [15:0] sdiv_16b (input logic [15:0] lhs, input logic [15:0] rhs);
// EXPECT-SV:     begin
// EXPECT-SV:       sdiv_16b = rhs == 16'h0000 ? (lhs[15] ? 16'h8000 : 16'h7fff) : (lhs == 16'h8000 && rhs == 16'hffff ? 16'h8000 : $unsigned($signed(lhs) / $signed(rhs)));
// EXPECT-SV:     end
// EXPECT-SV:   endfunction
// EXPECT-SV:   function automatic logic [15:0] smod_16b (input logic [15:0] lhs, input logic [15:0] rhs);
// EXPECT-SV:     begin
// EXPECT-SV:       smod_16b = rhs == 16'h0000 ? 16'h0000 : $unsigned($signed(lhs) % $signed(rhs));
// EXPECT-SV:     end
// EXPECT-SV:   endfunction
// EXPECT-SV:   logic [15:0] divided;
// EXPECT-SV:   logic [15:0] residue;
// EXPECT-SV:   assign divided = sdiv_16b(lhs, rhs);
// EXPECT-SV:   assign residue = smod_16b(lhs, rhs);
// EXPECT-SV:   assign quotient = divided;
// EXPECT-SV:   assign remainder = residue;
// EXPECT-SV: endmodule
