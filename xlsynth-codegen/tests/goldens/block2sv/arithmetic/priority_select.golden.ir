package priority_package

top block priority_choice(selector: bits[2], first: bits[8], second: bits[8], fallback: bits[8], out: bits[8]) {
  selector: bits[2] = input_port(name=selector, id=1)
  first: bits[8] = input_port(name=first, id=2)
  second: bits[8] = input_port(name=second, id=3)
  fallback: bits[8] = input_port(name=fallback, id=4)
  selected: bits[8] = priority_sel(selector, cases=[first, second], default=fallback, id=5)
  out: () = output_port(selected, name=out, id=6)
}

