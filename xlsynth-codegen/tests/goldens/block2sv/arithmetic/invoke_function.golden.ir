package invoke_package

fn add_constant(value: bits[8] id=1) -> bits[8] {
  constant: bits[8] = literal(value=5, id=2)
  ret result: bits[8] = add(value, constant, id=3)
}

top block invoke_function(data: bits[8], out: bits[8]) {
  data: bits[8] = input_port(name=data, id=4)
  result: bits[8] = invoke(data, to_apply=add_constant, id=5)
  out: () = output_port(result, name=out, id=6)
}

// OPTIONS: # BlockCodegenOptions defaults
// EXPECT-ERROR: invoke is not supported in `invoke_function`; inline function calls before block2sv code generation
