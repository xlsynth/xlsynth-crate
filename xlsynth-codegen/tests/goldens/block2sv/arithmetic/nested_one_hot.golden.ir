package nested_one_hot_package

top block nested_one_hot(data: bits[4], out: bits[3]) {
  data: bits[4] = input_port(name=data, id=1)
  one_hot.2: bits[5] = one_hot(data, lsb_prio=false, id=2)
  one_hot.3: bits[6] = one_hot(one_hot.2, lsb_prio=true, id=3)
  result: bits[3] = encode(one_hot.3, id=4)
  out: () = output_port(result, name=out, id=5)
}

