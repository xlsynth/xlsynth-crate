package slice_package

top block slices(lhs: bits[8], rhs: bits[8], out: bits[12]) {
  lhs: bits[8] = input_port(name=lhs, id=1)
  rhs: bits[8] = input_port(name=rhs, id=2)
  joined: bits[16] = concat(lhs, rhs, id=3)
  selected: bits[12] = bit_slice(joined, start=2, width=12, id=4)
  out: () = output_port(selected, name=out, id=5)
}

// OPTIONS: # BlockCodegenOptions defaults
// EXPECT-SV: module slices(
// EXPECT-SV:   input logic [7:0] lhs,
// EXPECT-SV:   input logic [7:0] rhs,
// EXPECT-SV:   output logic [11:0] out
// EXPECT-SV: );
// EXPECT-SV:   logic [15:0] joined;
// EXPECT-SV:   logic [11:0] selected;
// EXPECT-SV:   assign joined = {lhs, rhs};
// EXPECT-SV:   assign selected = joined[13:2];
// EXPECT-SV:   assign out = selected;
// EXPECT-SV: endmodule
