package priority_select_scalar_package

top block priority_select_scalar(selector: bits[1], value: bits[1], fallback: bits[1], out: bits[1]) {
  selector: bits[1] = input_port(name=selector, id=1)
  value: bits[1] = input_port(name=value, id=2)
  fallback: bits[1] = input_port(name=fallback, id=3)
  selected: bits[1] = priority_sel(selector, cases=[value], default=fallback, id=4)
  out: () = output_port(selected, name=out, id=5)
}

