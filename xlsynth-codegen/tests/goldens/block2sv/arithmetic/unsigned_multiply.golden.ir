package unsigned_multiply_package

top block unsigned_multiply(lhs: bits[9], rhs: bits[11], out: bits[20]) {
  lhs: bits[9] = input_port(name=lhs, id=1)
  rhs: bits[11] = input_port(name=rhs, id=2)
  product: bits[20] = umul(lhs, rhs, id=3)
  out: () = output_port(product, name=out, id=4)
}

