package literal_one_hot_package

top block literal_one_hot(first: bits[8], second: bits[8], third: bits[8], out: bits[8]) {
  first: bits[8] = input_port(name=first, id=1)
  second: bits[8] = input_port(name=second, id=2)
  third: bits[8] = input_port(name=third, id=3)
  literal.4: bits[3] = literal(value=5, id=4)
  selected: bits[8] = one_hot_sel(literal.4, cases=[first, second, third], id=5)
  out: () = output_port(selected, name=out, id=6)
}

