package arithmetic_intermediates_package

top block arithmetic_intermediates(lhs: bits[8], rhs: bits[8], divisor: bits[8], out: bits[8]) {
  lhs: bits[8] = input_port(name=lhs, id=1)
  rhs: bits[8] = input_port(name=rhs, id=2)
  divisor: bits[8] = input_port(name=divisor, id=3)
  add.4: bits[8] = add(lhs, rhs, id=4)
  sub.5: bits[8] = sub(add.4, rhs, id=5)
  umul.6: bits[8] = umul(sub.5, rhs, id=6)
  udiv.7: bits[8] = udiv(umul.6, divisor, id=7)
  out: () = output_port(udiv.7, name=out, id=8)
}

