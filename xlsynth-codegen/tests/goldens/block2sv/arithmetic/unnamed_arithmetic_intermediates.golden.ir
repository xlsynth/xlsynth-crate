// EXPECT-SV:     begin
// EXPECT-SV:       umul8b_8b_x_8b = lhs * rhs;
// EXPECT-SV:     end
// EXPECT-SV:   endfunction
// EXPECT-SV:   function automatic logic [7:0] udiv_8b (input logic [7:0] lhs, input logic [7:0] rhs);
// EXPECT-SV:     begin
// EXPECT-SV:       udiv_8b = rhs == 8'h00 ? '1 : lhs / rhs;
// EXPECT-SV:     end
// EXPECT-SV:   endfunction
// EXPECT-SV:   logic [7:0] add_4;
// EXPECT-SV:   logic [7:0] sub_5;
// EXPECT-SV:   logic [7:0] umul_6;
// EXPECT-SV:   logic [7:0] udiv_7;
// EXPECT-SV:   assign add_4 = lhs + rhs;
// EXPECT-SV:   assign sub_5 = add_4 - rhs;
// EXPECT-SV:   assign umul_6 = umul8b_8b_x_8b(sub_5, rhs);
// EXPECT-SV:   assign udiv_7 = udiv_8b(umul_6, divisor);
// EXPECT-SV:   assign out = udiv_7;
// EXPECT-SV: endmodule
