package dynamic_slice_package

top block dynamic_slice(data: bits[24], start: bits[5], out: bits[8]) {
  data: bits[24] = input_port(name=data, id=1)
  start: bits[5] = input_port(name=start, id=2)
  selected: bits[8] = dynamic_bit_slice(data, start, width=8, id=3)
  out: () = output_port(selected, name=out, id=4)
}

