package extended_normalize_count_package

top block extended_normalize_count(data: bits[8], out: (bits[16], bits[4])) {
  data: bits[8] = input_port(name=data, id=1)
  result: (bits[16], bits[4]) = ext_normalize_left(data, shift_offset=1, normalized_bit_count=16, clz_bit_count=4, id=2)
  out: () = output_port(result, name=out, id=3)
}

