package collision_package

top block name_collision(data: bits[8], add_3: bits[8], out: bits[8]) {
  data: bits[8] = input_port(name=data, id=1)
  add_3: bits[8] = input_port(name=add_3, id=2)
  add.3: bits[8] = add(data, add_3, id=3)
  out: () = output_port(add.3, name=out, id=4)
}

