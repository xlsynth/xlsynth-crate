package extended_normalize_package

top block extended_normalize(data: bits[8], out: bits[16]) {
  data: bits[8] = input_port(name=data, id=1)
  result: bits[16] = ext_normalize_left(data, shift_offset=1, normalized_bit_count=16, id=2)
  out: () = output_port(result, name=out, id=3)
}

