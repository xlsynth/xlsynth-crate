// EXPECT-SV:     unique casez (value)
// EXPECT-SV:       1'b1: clz_1_1_offset_1 = 1'h1;
// EXPECT-SV:       default: clz_1_1_offset_1 = 1'h0;
// EXPECT-SV:     endcase
// EXPECT-SV:   endfunction
// EXPECT-SV:   logic result;
// EXPECT-SV:   assign result = clz_1_1_offset_1(data);
// EXPECT-SV:   assign out = result;
// EXPECT-SV: endmodule
