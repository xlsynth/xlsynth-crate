package extended_leading_scalar_package

top block extended_leading_scalar(data: bits[1], out: bits[1]) {
  data: bits[1] = input_port(name=data, id=1)
  result: bits[1] = ext_clz(data, offset=1, new_bit_count=1, id=2)
  out: () = output_port(result, name=out, id=3)
}

