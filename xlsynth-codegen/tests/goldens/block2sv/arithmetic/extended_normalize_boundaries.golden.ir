package extended_normalize_boundaries_package

top block extended_normalize_boundaries(data: bits[5], out: (bits[3], bits[2])) {
  data: bits[5] = input_port(name=data, id=1)
  result: (bits[3], bits[2]) = ext_normalize_left(data, shift_offset=1, normalized_bit_count=3, clz_bit_count=2, id=2)
  out: () = output_port(result, name=out, id=3)
}

