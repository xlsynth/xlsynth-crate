package encode_non_power_of_two_package

top block encode_non_power_of_two(data: bits[5], out: bits[3]) {
  data: bits[5] = input_port(name=data, id=1)
  encoded: bits[3] = encode(data, id=2)
  out: () = output_port(encoded, name=out, id=3)
}

