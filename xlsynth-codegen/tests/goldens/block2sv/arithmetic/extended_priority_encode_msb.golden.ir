package extended_priority_msb_package

top block extended_priority_msb(data: bits[8], out: bits[4]) {
  data: bits[8] = input_port(name=data, id=1)
  result: bits[4] = ext_prio_encode(data, lsb_prio=false, id=2)
  out: () = output_port(result, name=out, id=3)
}

