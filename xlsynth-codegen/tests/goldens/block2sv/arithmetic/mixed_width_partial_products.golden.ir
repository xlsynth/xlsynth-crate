package mixed_width_partial_products_package

top block mixed_width_partial_products(lhs: bits[3], rhs: bits[5], signed_parts: (bits[4], bits[4]), unsigned_parts: (bits[4], bits[4])) {
  lhs: bits[3] = input_port(name=lhs, id=1)
  rhs: bits[5] = input_port(name=rhs, id=2)
  signed_result: (bits[4], bits[4]) = smulp(lhs, rhs, id=3)
  unsigned_result: (bits[4], bits[4]) = umulp(lhs, rhs, id=4)
  signed_parts: () = output_port(signed_result, name=signed_parts, id=5)
  unsigned_parts: () = output_port(unsigned_result, name=unsigned_parts, id=6)
}

