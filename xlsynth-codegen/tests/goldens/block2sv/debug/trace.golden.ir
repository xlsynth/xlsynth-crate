package trace_package

top block trace_data(clk: clock, flag: bits[1], data: bits[8], out: bits[8]) {
  flag: bits[1] = input_port(name=flag, id=1)
  data: bits[8] = input_port(name=data, id=2)
  token: token = after_all(id=3)
  traced: token = trace(token, flag, format="data={}", data_operands=[data], verbosity=0, id=4)
  out: () = output_port(data, name=out, id=5)
}

// OPTIONS: # BlockCodegenOptions defaults
// EXPECT-SV: module trace_data(
// EXPECT-SV:   input logic clk,
// EXPECT-SV:   input logic flag,
// EXPECT-SV:   input logic [7:0] data,
// EXPECT-SV:   output logic [7:0] out
// EXPECT-SV: );
// EXPECT-SV:   `ifndef SYNTHESIS
// EXPECT-SV:   always @(posedge clk) begin
// EXPECT-SV:     if (flag) $display("data=%0d", data);
// EXPECT-SV:   end
// EXPECT-SV:   `endif
// EXPECT-SV:   assign out = data;
// EXPECT-SV: endmodule
