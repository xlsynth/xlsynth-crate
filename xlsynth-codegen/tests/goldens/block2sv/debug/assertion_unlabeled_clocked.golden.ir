package unlabeled_clocked_assertion_package

top block unlabeled_clocked_assertion(clk: clock, valid: bits[1], data: bits[8], out: bits[8]) {
  valid: bits[1] = input_port(name=valid, id=1)
  data: bits[8] = input_port(name=data, id=2)
  token: token = after_all(id=3)
  checked: token = assert(token, valid, message="input must be valid", id=4)
  out: () = output_port(data, name=out, id=5)
}

// OPTIONS: # BlockCodegenOptions defaults
// EXPECT-SV: module unlabeled_clocked_assertion(
// EXPECT-SV:   input logic clk,
// EXPECT-SV:   input logic valid,
// EXPECT-SV:   input logic [7:0] data,
// EXPECT-SV:   output logic [7:0] out
// EXPECT-SV: );
// EXPECT-SV:   `ifndef SYNTHESIS
// EXPECT-SV:   assert property (@(posedge clk) disable iff ($sampled($isunknown(valid))) valid) else $error("input must be valid");
// EXPECT-SV:   `endif
// EXPECT-SV:   assign out = data;
// EXPECT-SV: endmodule
