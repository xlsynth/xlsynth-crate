package helper_debug_package

fn checked_helper(value: bits[8] id=1) -> bits[8] {
  zero: bits[8] = literal(value=0, id=2)
  valid: bits[1] = ne(value, zero, id=3)
  token: token = after_all(id=4)
  checked: token = assert(token, valid, message="helper input must be nonzero", id=5)
  traced: token = trace(checked, valid, format="helper={:x}", data_operands=[value], verbosity=0, id=6)
  ret result: bits[8] = identity(value, id=7)
}

top block helper_debug(clk: clock, data: bits[8], out: bits[8]) {
  data: bits[8] = input_port(name=data, id=8)
  result: bits[8] = invoke(data, to_apply=checked_helper, id=9)
  out: () = output_port(result, name=out, id=10)
}

// OPTIONS: # BlockCodegenOptions defaults
// EXPECT-ERROR: invoke is not supported in `helper_debug`; inline function calls before block2sv code generation
