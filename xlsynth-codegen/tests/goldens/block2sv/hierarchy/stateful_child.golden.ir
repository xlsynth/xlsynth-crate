package stateful_child_package

block delay(clk: clock, data: bits[8], out: bits[8]) {
  reg state(bits[8])
  data: bits[8] = input_port(name=data, id=1)
  state_q: bits[8] = register_read(register=state, id=2)
  state_d: () = register_write(data, register=state, id=3)
  out: () = output_port(state_q, name=out, id=4)
}

top block parent_delay(clk: clock, data: bits[8], out: bits[8]) {
  instantiation child(block=delay, kind=block)
  data: bits[8] = input_port(name=data, id=5)
  child_input: () = instantiation_input(data, instantiation=child, port_name=data, id=6)
  child_output: bits[8] = instantiation_output(instantiation=child, port_name=out, id=7)
  out: () = output_port(child_output, name=out, id=8)
}

// OPTIONS: # BlockCodegenOptions defaults
// EXPECT-SV: module delay(
// EXPECT-SV:   input logic clk,
// EXPECT-SV:   input logic [7:0] data,
// EXPECT-SV:   output logic [7:0] out
// EXPECT-SV: );
// EXPECT-SV:   logic [7:0] state;
// EXPECT-SV:   always_ff @ (posedge clk) begin
// EXPECT-SV:     state <= data;
// EXPECT-SV:   end
// EXPECT-SV:   assign out = state;
// EXPECT-SV: endmodule
// EXPECT-SV: module parent_delay(
// EXPECT-SV:   input logic clk,
// EXPECT-SV:   input logic [7:0] data,
// EXPECT-SV:   output logic [7:0] out
// EXPECT-SV: );
// EXPECT-SV:   logic [7:0] child_output;
// EXPECT-SV:   assign out = child_output;
// EXPECT-SV:   delay child (
// EXPECT-SV:     .clk(clk),
// EXPECT-SV:     .data(data),
// EXPECT-SV:     .out(child_output)
// EXPECT-SV:   );
// EXPECT-SV: endmodule
