package diamond_package

block leaf(data: bits[8], out: bits[8]) {
  data: bits[8] = input_port(name=data, id=1)
  inverted: bits[8] = not(data, id=2)
  out: () = output_port(inverted, name=out, id=3)
}

block left(data: bits[8], out: bits[8]) {
  instantiation child(block=leaf, kind=block)
  data: bits[8] = input_port(name=data, id=4)
  child_input: () = instantiation_input(data, instantiation=child, port_name=data, id=5)
  child_output: bits[8] = instantiation_output(instantiation=child, port_name=out, id=6)
  out: () = output_port(child_output, name=out, id=7)
}

block right(data: bits[8], out: bits[8]) {
  instantiation child(block=leaf, kind=block)
  data: bits[8] = input_port(name=data, id=8)
  child_input: () = instantiation_input(data, instantiation=child, port_name=data, id=9)
  child_output: bits[8] = instantiation_output(instantiation=child, port_name=out, id=10)
  out: () = output_port(child_output, name=out, id=11)
}

top block diamond(data: bits[8], out: bits[8]) {
  instantiation first(block=left, kind=block)
  instantiation second(block=right, kind=block)
  data: bits[8] = input_port(name=data, id=12)
  first_input: () = instantiation_input(data, instantiation=first, port_name=data, id=13)
  second_input: () = instantiation_input(data, instantiation=second, port_name=data, id=14)
  first_output: bits[8] = instantiation_output(instantiation=first, port_name=out, id=15)
  second_output: bits[8] = instantiation_output(instantiation=second, port_name=out, id=16)
  combined: bits[8] = xor(first_output, second_output, id=17)
  out: () = output_port(combined, name=out, id=18)
}

// OPTIONS: # BlockCodegenOptions defaults
// EXPECT-SV: module leaf(
// EXPECT-SV:   input logic [7:0] data,
// EXPECT-SV:   output logic [7:0] out
// EXPECT-SV: );
// EXPECT-SV:   logic [7:0] inverted;
// EXPECT-SV:   assign inverted = ~data;
// EXPECT-SV:   assign out = inverted;
// EXPECT-SV: endmodule
// EXPECT-SV: module left(
// EXPECT-SV:   input logic [7:0] data,
// EXPECT-SV:   output logic [7:0] out
// EXPECT-SV: );
// EXPECT-SV:   logic [7:0] child_output;
// EXPECT-SV:   assign out = child_output;
// EXPECT-SV:   leaf child (
// EXPECT-SV:     .data(data),
// EXPECT-SV:     .out(child_output)
// EXPECT-SV:   );
// EXPECT-SV: endmodule
// EXPECT-SV: module right(
// EXPECT-SV:   input logic [7:0] data,
// EXPECT-SV:   output logic [7:0] out
// EXPECT-SV: );
// EXPECT-SV:   logic [7:0] child_output;
// EXPECT-SV:   assign out = child_output;
// EXPECT-SV:   leaf child (
// EXPECT-SV:     .data(data),
// EXPECT-SV:     .out(child_output)
// EXPECT-SV:   );
// EXPECT-SV: endmodule
// EXPECT-SV: module diamond(
// EXPECT-SV:   input logic [7:0] data,
// EXPECT-SV:   output logic [7:0] out
// EXPECT-SV: );
// EXPECT-SV:   logic [7:0] first_output;
// EXPECT-SV:   logic [7:0] second_output;
// EXPECT-SV:   logic [7:0] combined;
// EXPECT-SV:   assign combined = first_output ^ second_output;
// EXPECT-SV:   assign out = combined;
// EXPECT-SV:   left first (
// EXPECT-SV:     .data(data),
// EXPECT-SV:     .out(first_output)
// EXPECT-SV:   );
// EXPECT-SV:   right second (
// EXPECT-SV:     .data(data),
// EXPECT-SV:     .out(second_output)
// EXPECT-SV:   );
// EXPECT-SV: endmodule
