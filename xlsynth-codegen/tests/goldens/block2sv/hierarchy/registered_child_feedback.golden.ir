// EXPECT-SV:   input logic [7:0] step,
// EXPECT-SV:   output logic [7:0] out
// EXPECT-SV: );
// EXPECT-SV:   logic [7:0] child_output;
// EXPECT-SV:   logic [7:0] next;
// EXPECT-SV:   assign next = child_output + step;
// EXPECT-SV:   assign out = child_output;
