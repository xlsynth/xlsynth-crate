// EXPECT-SV:     .child_clk(parent_clk),
// EXPECT-SV:     .child_reset(parent_reset),
// EXPECT-SV:     .data(next),
// EXPECT-SV:     .out(child_output)
// EXPECT-SV:   );
// EXPECT-SV: endmodule
