// EXPECT-SV: module feedback_delay(
// EXPECT-SV:   input logic child_clk,
// EXPECT-SV:   input logic child_reset,
// EXPECT-SV:   input logic [7:0] data,
// EXPECT-SV:   output logic [7:0] out
// EXPECT-SV: );
// EXPECT-SV:   logic [7:0] state;
// EXPECT-SV:   always_ff @ (posedge child_clk) begin
// EXPECT-SV:     if (child_reset) begin
// EXPECT-SV:       state <= 8'h00;
// EXPECT-SV:     end else begin
// EXPECT-SV:       state <= data;
// EXPECT-SV:     end
// EXPECT-SV:   end
// EXPECT-SV:   assign out = state;
// EXPECT-SV: endmodule
// EXPECT-SV: module registered_feedback(
// EXPECT-SV:   input logic parent_clk,
