package shared_ranges

block probe(io: bits[6], seen: bits[6]) {
  ext_inout_net wire(bits[6])
  io: () = ext_inout_port(name=io, net=wire, id=1)
  sample: bits[6] = ext_inout_read(net=wire, id=2)
  seen: () = output_port(sample, name=seen, id=3)
}

top block wrapper(a: bits[8], b: bits[2], seen: bits[12]) {
  ext_inout_net bus(bits[12])
  ext_inout_net spare(bits[6])
  a: () = ext_inout_port(name=a, net={spare, bus[11:10]}, sv_type="types::input_t", id=4)
  b: () = ext_inout_port(name=b, net=bus[1:0], id=5)
  instantiation hi(block=probe, kind=block)
  instantiation lo(block=probe, kind=block)
  h: () = ext_instantiation_inout(instantiation=hi, port_name=io, net=bus[11:6], id=6)
  l: () = ext_instantiation_inout(instantiation=lo, port_name=io, net=bus[5:0], id=7)
  high: bits[6] = instantiation_output(instantiation=hi, port_name=seen, id=8)
  low: bits[6] = instantiation_output(instantiation=lo, port_name=seen, id=9)
  sample: bits[12] = concat(high, low, id=10)
  seen: () = output_port(sample, name=seen, id=11)
}

// EXPECT-SV: module probe(
// EXPECT-SV:   inout wire [5:0] io,
// EXPECT-SV:   output logic [5:0] seen
// EXPECT-SV: );
// EXPECT-SV:   assign seen = io;
// EXPECT-SV: endmodule
// EXPECT-SV: module wrapper(
// EXPECT-SV:   inout wire types::input_t a,
// EXPECT-SV:   inout wire [1:0] b,
// EXPECT-SV:   output logic [11:0] seen
// EXPECT-SV: );
// EXPECT-SV:   wire [7:0] a_bits;
// EXPECT-SV:   tran a_tie[7:0](a, a_bits);
// EXPECT-SV:   wire [11:0] bus;
// EXPECT-SV:   logic [5:0] high;
// EXPECT-SV:   logic [5:0] low;
// EXPECT-SV:   logic [11:0] sample;
// EXPECT-SV:   assign sample = {high, low};
// EXPECT-SV:   assign seen = sample;
// EXPECT-SV:   probe hi (
// EXPECT-SV:     .io({a_bits[1:0], bus[9:6]}),
// EXPECT-SV:     .seen(high)
// EXPECT-SV:   );
// EXPECT-SV:   probe lo (
// EXPECT-SV:     .io({bus[5:2], b}),
// EXPECT-SV:     .seen(low)
// EXPECT-SV:   );
// EXPECT-SV: endmodule
