// EXPECT-SV:   inout wire [1:0][1:0] b
// EXPECT-SV: );
// EXPECT-SV:
// EXPECT-SV: endmodule
// EXPECT-SV: module host(
// EXPECT-SV:   input logic [1:0][1:0] tx,
// EXPECT-SV:   input logic oe,
// EXPECT-SV:   output logic [1:0][1:0] rx
// EXPECT-SV: );
// EXPECT-SV:   wire [1:0][1:0] reader_io;
// EXPECT-SV:   wire [1:0][1:0] writer_io;
// EXPECT-SV:   assign writer_io = oe ? tx : 'z;
// EXPECT-SV:   assign rx = reader_io;
// EXPECT-SV:   forward reader (
// EXPECT-SV:     .io(reader_io)
// EXPECT-SV:   );
// EXPECT-SV:   forward writer (
// EXPECT-SV:     .io(writer_io)
// EXPECT-SV:   );
// EXPECT-SV:   insulated isolator (
// EXPECT-SV:     .a(reader_io),
// EXPECT-SV:     .b(writer_io)
// EXPECT-SV:   );
// EXPECT-SV: endmodule
