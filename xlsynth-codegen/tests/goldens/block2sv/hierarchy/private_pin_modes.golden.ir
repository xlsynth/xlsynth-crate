package private_modes

block contact(io: bits[2][2], probe: bits[2][2]) {
  ext_inout_net io(bits[2][2])
  port_io: () = ext_inout_port(name=io, net=io, id=10)
  port_probe: () = ext_inout_port(name=probe, net=io, id=11)
}

block forward(io: bits[2][2]) {
  ext_inout_net io(bits[2][2])
  ext_inout_net test_point(bits[2][2])
  instantiation leaf(block=contact, kind=block)
  port_io: () = ext_inout_port(name=io, net=io, id=12)
  bind: () = ext_instantiation_inout(instantiation=leaf, port_name=io, net=io, id=1)
  test_link: () = ext_instantiation_inout(instantiation=leaf, port_name=probe, net=test_point, id=9)
}

block insulated(a: bits[2][2], b: bits[2][2]) {
  left_pin: () = ext_inout_port(name=a, id=19)
  right_pin: () = ext_inout_port(name=b, id=20)
}

top block host(tx: bits[2][2], oe: bits[1], rx: bits[2][2]) {
  ext_inout_net reader_io(bits[2][2])
  ext_inout_net writer_io(bits[2][2])
  instantiation reader(block=forward, kind=block)
  instantiation writer(block=forward, kind=block)
  instantiation isolator(block=insulated, kind=block)
  left_open: () = ext_instantiation_inout(instantiation=isolator, port_name=a, net=reader_io, id=21)
  right_open: () = ext_instantiation_inout(instantiation=isolator, port_name=b, net=writer_io, id=22)
  tx: bits[2][2] = input_port(name=tx, id=2)
  oe: bits[1] = input_port(name=oe, id=3)
  read_link: () = ext_instantiation_inout(instantiation=reader, port_name=io, net=reader_io, id=7)
  write_link: () = ext_instantiation_inout(instantiation=writer, port_name=io, net=writer_io, id=8)
  sense: bits[2][2] = ext_inout_read(net=reader_io, id=4)
  drive: () = ext_inout_drive(tx, oe, net=writer_io, id=5)
  rx: () = output_port(sense, name=rx, id=6)
}

