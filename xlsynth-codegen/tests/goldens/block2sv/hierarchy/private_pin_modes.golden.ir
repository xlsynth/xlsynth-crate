// EXPECT-SV:   inout wire [1:0][1:0] io,
// EXPECT-SV:   inout wire [1:0][1:0] probe
// EXPECT-SV: );
// EXPECT-SV:   tran probe_tie[3:0](io, probe);
// EXPECT-SV: endmodule
