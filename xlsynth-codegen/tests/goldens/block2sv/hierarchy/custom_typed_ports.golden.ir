package typed_hierarchy

block typed_child(code: bits[2], pair: bits[2], inverted: bits[2], forwarded: bits[2]) {
  code: bits[2] = input_port(name=code, sv_type="data__1", id=1)
  pair: bits[2] = input_port(name=pair, sv_type="types::pair_t", id=2)
  not.3: bits[2] = not(code, id=3)
  inverted: () = output_port(not.3, name=inverted, sv_type="data__1", id=4)
  forwarded: () = output_port(pair, name=forwarded, sv_type="types::pair_t", id=5)
}

top block typed_parent(data: bits[2], result: bits[2], forwarded: bits[2]) {
  instantiation child(block=typed_child, kind=block)
  data: bits[2] = input_port(name=data, sv_type="data__1", id=6)
  instantiation_input.7: () = instantiation_input(data, instantiation=child, port_name=code, id=7)
  instantiation_input.8: () = instantiation_input(data, instantiation=child, port_name=pair, id=8)
  inv: bits[2] = instantiation_output(instantiation=child, port_name=inverted, id=9)
  pair: bits[2] = instantiation_output(instantiation=child, port_name=forwarded, id=10)
  result: () = output_port(inv, name=result, sv_type="data__1", id=11)
  forwarded: () = output_port(pair, name=forwarded, sv_type="types::pair_t", id=12)
}

