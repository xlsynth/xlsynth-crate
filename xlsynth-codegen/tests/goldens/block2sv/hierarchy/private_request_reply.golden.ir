package private_request_reply

block device(clk: clock, capture: bits[1], reply: bits[1], io: bits[4], last_request: bits[4]) {
  ext_inout_net io(bits[4], ports=[io])
  reg saved(bits[4])
  capture: bits[1] = input_port(name=capture, id=1)
  reply: bits[1] = input_port(name=reply, id=2)
  sample: bits[4] = ext_inout_read(net=io, id=3)
  stored: bits[4] = register_read(register=saved, id=4)
  save: () = register_write(sample, register=saved, load_enable=capture, id=5)
  response: bits[4] = not(stored, id=6)
  drive: () = ext_inout_drive(response, reply, net=io, id=7)
  last_request: () = output_port(stored, name=last_request, id=8)
}

block contact(io: bits[4], probe: bits[4]) {
  ext_inout_net bridge(bits[4], ports=[io, probe])
}

top block host(clk: clock, u_device_io: bits[4], send: bits[1], capture: bits[1], reply: bits[1], rx: bits[4], rx_again: bits[4], last_request: bits[4]) {
  ext_inout_net u_device_io(bits[4])
  ext_inout_net monitor(bits[4])
  instantiation observer(block=contact, kind=block)
  instantiation u_device(block=device, kind=block)
  device_link: () = ext_instantiation_inout(instantiation=u_device, port_name=io, net=u_device_io, id=22)
  observer_link: () = ext_instantiation_inout(instantiation=observer, port_name=io, net=u_device_io, id=23)
  monitor_link: () = ext_instantiation_inout(instantiation=observer, port_name=probe, net=monitor, id=24)
  u_device_io: bits[4] = input_port(name=u_device_io, id=9)
  send: bits[1] = input_port(name=send, id=10)
  capture: bits[1] = input_port(name=capture, id=11)
  reply: bits[1] = input_port(name=reply, id=12)
  drive: () = ext_inout_drive(u_device_io, send, net=u_device_io, id=13)
  sample: bits[4] = ext_inout_read(net=u_device_io, id=14)
  duplicate_sample: bits[4] = ext_inout_read(net=u_device_io, id=15)
  capture_request: () = instantiation_input(capture, instantiation=u_device, port_name=capture, id=16)
  send_reply: () = instantiation_input(reply, instantiation=u_device, port_name=reply, id=17)
  stored: bits[4] = instantiation_output(instantiation=u_device, port_name=last_request, id=18)
  rx: () = output_port(sample, name=rx, id=19)
  rx_again: () = output_port(duplicate_sample, name=rx_again, id=20)
  last_request: () = output_port(stored, name=last_request, id=21)
}

// EXPECT-SV: module contact(
// EXPECT-SV:   inout wire [3:0] io,
// EXPECT-SV:   inout wire [3:0] probe
// EXPECT-SV: );
// EXPECT-SV:   tran probe_tie[3:0](io, probe);
// EXPECT-SV: endmodule
// EXPECT-SV: module device(
// EXPECT-SV:   input logic clk,
// EXPECT-SV:   input logic capture,
// EXPECT-SV:   input logic reply,
// EXPECT-SV:   inout wire [3:0] io,
// EXPECT-SV:   output logic [3:0] last_request
// EXPECT-SV: );
// EXPECT-SV:   logic [3:0] saved;
// EXPECT-SV:   logic [3:0] response;
// EXPECT-SV:   assign response = ~saved;
// EXPECT-SV:   assign io = reply ? response : 'z;
// EXPECT-SV:   always_ff @ (posedge clk) begin
// EXPECT-SV:     saved <= capture ? io : saved;
// EXPECT-SV:   end
// EXPECT-SV:   assign last_request = saved;
// EXPECT-SV: endmodule
// EXPECT-SV: module host(
// EXPECT-SV:   input logic clk,
// EXPECT-SV:   input logic [3:0] u_device_io,
// EXPECT-SV:   input logic send,
// EXPECT-SV:   input logic capture,
// EXPECT-SV:   input logic reply,
// EXPECT-SV:   output logic [3:0] rx,
// EXPECT-SV:   output logic [3:0] rx_again,
// EXPECT-SV:   output logic [3:0] last_request
// EXPECT-SV: );
// EXPECT-SV:   wire [3:0] u_device_io__1;
// EXPECT-SV:   wire [3:0] monitor;
// EXPECT-SV:   logic [3:0] stored;
// EXPECT-SV:   assign u_device_io__1 = send ? u_device_io : 'z;
// EXPECT-SV:   assign rx = u_device_io__1;
// EXPECT-SV:   assign rx_again = u_device_io__1;
// EXPECT-SV:   assign last_request = stored;
// EXPECT-SV:   contact observer (
// EXPECT-SV:     .io(u_device_io__1),
// EXPECT-SV:     .probe(monitor)
// EXPECT-SV:   );
// EXPECT-SV:   device u_device (
// EXPECT-SV:     .clk(clk),
// EXPECT-SV:     .capture(capture),
// EXPECT-SV:     .reply(reply),
// EXPECT-SV:     .io(u_device_io__1),
// EXPECT-SV:     .last_request(stored)
// EXPECT-SV:   );
// EXPECT-SV: endmodule
