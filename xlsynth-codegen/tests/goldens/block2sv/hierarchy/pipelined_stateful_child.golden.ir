package pipelined_stateful_child_package

block child_delay(child_clk: clock, data: bits[8], out: bits[8]) {
  reg child_state(bits[8])
  data: bits[8] = input_port(name=data, id=1)
  child_q: bits[8] = register_read(register=child_state, id=2)
  child_d: () = register_write(data, register=child_state, id=3)
  out: () = output_port(child_q, name=out, id=4)
}

top block stateful_pipeline_parent(parent_clk: clock, data: bits[8], out: bits[8]) {
  instantiation child(block=child_delay, kind=block)
  reg input_stage(bits[8])
  reg output_stage(bits[8])
  data: bits[8] = input_port(name=data, id=5)
  input_q: bits[8] = register_read(register=input_stage, id=6)
  input_d: () = register_write(data, register=input_stage, id=7)
  child_input: () = instantiation_input(input_q, instantiation=child, port_name=data, id=8)
  child_output: bits[8] = instantiation_output(instantiation=child, port_name=out, id=9)
  output_q: bits[8] = register_read(register=output_stage, id=10)
  output_d: () = register_write(child_output, register=output_stage, id=11)
  out: () = output_port(output_q, name=out, id=12)
}

