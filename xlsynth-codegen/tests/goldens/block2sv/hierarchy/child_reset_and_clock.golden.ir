package hierarchical_reset_package

block registered_child(child_clk: clock, child_rst: bits[1], data: bits[8], out: bits[8]) {
  #![reset(port="child_rst", asynchronous=false, active_low=false)]
  reg state(bits[8], reset_value=0)
  child_rst: bits[1] = input_port(name=child_rst, id=1)
  data: bits[8] = input_port(name=data, id=2)
  state_q: bits[8] = register_read(register=state, id=3)
  state_d: () = register_write(data, register=state, reset=child_rst, id=4)
  out: () = output_port(state_q, name=out, id=5)
}

top block reset_parent(parent_clk: clock, parent_rst: bits[1], data: bits[8], out: bits[8]) {
  instantiation child(block=registered_child, kind=block)
  parent_rst: bits[1] = input_port(name=parent_rst, id=6)
  data: bits[8] = input_port(name=data, id=7)
  child_reset: () = instantiation_input(parent_rst, instantiation=child, port_name=child_rst, id=8)
  child_input: () = instantiation_input(data, instantiation=child, port_name=data, id=9)
  child_output: bits[8] = instantiation_output(instantiation=child, port_name=out, id=10)
  out: () = output_port(child_output, name=out, id=11)
}

// OPTIONS: # BlockCodegenOptions defaults
// EXPECT-SV: module registered_child(
// EXPECT-SV:   input logic child_clk,
// EXPECT-SV:   input logic child_rst,
// EXPECT-SV:   input logic [7:0] data,
// EXPECT-SV:   output logic [7:0] out
// EXPECT-SV: );
// EXPECT-SV:   logic [7:0] state;
// EXPECT-SV:   always_ff @ (posedge child_clk) begin
// EXPECT-SV:     if (child_rst) begin
// EXPECT-SV:       state <= 8'h00;
// EXPECT-SV:     end else begin
// EXPECT-SV:       state <= data;
// EXPECT-SV:     end
// EXPECT-SV:   end
// EXPECT-SV:   assign out = state;
// EXPECT-SV: endmodule
// EXPECT-SV: module reset_parent(
// EXPECT-SV:   input logic parent_clk,
// EXPECT-SV:   input logic parent_rst,
// EXPECT-SV:   input logic [7:0] data,
// EXPECT-SV:   output logic [7:0] out
// EXPECT-SV: );
// EXPECT-SV:   logic [7:0] child_output;
// EXPECT-SV:   assign out = child_output;
// EXPECT-SV:   registered_child child (
// EXPECT-SV:     .child_clk(parent_clk),
// EXPECT-SV:     .child_rst(parent_rst),
// EXPECT-SV:     .data(data),
// EXPECT-SV:     .out(child_output)
// EXPECT-SV:   );
// EXPECT-SV: endmodule
