package tuple_index_package

top block select_tuple(data: (bits[8], bits[12]), out: bits[12]) {
  data: (bits[8], bits[12]) = input_port(name=data, id=1)
  selected: bits[12] = tuple_index(data, index=1, id=2)
  out: () = output_port(selected, name=out, id=3)
}

