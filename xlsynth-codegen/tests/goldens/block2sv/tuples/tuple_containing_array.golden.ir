package tuple_array_package

top block tuple_array(data: (bits[8][2], bits[4]), index: bits[1], out: bits[8]) {
  data: (bits[8][2], bits[4]) = input_port(name=data, id=1)
  index: bits[1] = input_port(name=index, id=2)
  values: bits[8][2] = tuple_index(data, index=0, id=3)
  selected: bits[8] = array_index(values, indices=[index], id=4)
  out: () = output_port(selected, name=out, id=5)
}

