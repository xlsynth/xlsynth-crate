package mixed_reset_package

top block mixed_reset(clk: clock, rst: bits[1], data: bits[8], reset_out: bits[8], plain_out: bits[8]) {
  #![reset(port="rst", asynchronous=false, active_low=false)]
  reg reset_state(bits[8], reset_value=0)
  reg plain_state(bits[8])
  rst: bits[1] = input_port(name=rst, id=1)
  data: bits[8] = input_port(name=data, id=2)
  reset_q: bits[8] = register_read(register=reset_state, id=3)
  reset_d: () = register_write(data, register=reset_state, reset=rst, id=4)
  plain_q: bits[8] = register_read(register=plain_state, id=5)
  plain_d: () = register_write(data, register=plain_state, id=6)
  reset_out: () = output_port(reset_q, name=reset_out, id=7)
  plain_out: () = output_port(plain_q, name=plain_out, id=8)
}

// OPTIONS: # BlockCodegenOptions defaults
// EXPECT-SV: module mixed_reset(
// EXPECT-SV:   input logic clk,
// EXPECT-SV:   input logic rst,
// EXPECT-SV:   input logic [7:0] data,
// EXPECT-SV:   output logic [7:0] reset_out,
// EXPECT-SV:   output logic [7:0] plain_out
// EXPECT-SV: );
// EXPECT-SV:   logic [7:0] reset_state;
// EXPECT-SV:   logic [7:0] plain_state;
// EXPECT-SV:   always_ff @ (posedge clk) begin
// EXPECT-SV:     plain_state <= data;
// EXPECT-SV:   end
// EXPECT-SV:   always_ff @ (posedge clk) begin
// EXPECT-SV:     if (rst) begin
// EXPECT-SV:       reset_state <= 8'h00;
// EXPECT-SV:     end else begin
// EXPECT-SV:       reset_state <= data;
// EXPECT-SV:     end
// EXPECT-SV:   end
// EXPECT-SV:   assign reset_out = reset_state;
// EXPECT-SV:   assign plain_out = plain_state;
// EXPECT-SV: endmodule
