package pipeline_shared_constants

top block shared_constants(clk: clock, data: bits[1], literal_result: bits[1], computed_result: bits[1]) {
  reg r0(bits[1])
  reg r1(bits[1])
  reg r2(bits[1])
  data: bits[1] = input_port(name=data, id=1)
  r0_q: bits[1] = register_read(register=r0, id=2)
  r1_q: bits[1] = register_read(register=r1, id=3)
  r2_q: bits[1] = register_read(register=r2, id=4)
  one: bits[1] = literal(value=1, id=5)
  unused_literal_consumer: bits[1] = not(one, id=6)
  empty: bits[0] = concat(id=7)
  different: bits[1] = ne(empty, empty, id=8)
  computed: bits[1] = xor_reduce(different, id=9)
  unused_computed_consumer: bits[1] = not(computed, id=10)
  r0_d: () = register_write(data, register=r0, id=11)
  r1_d: () = register_write(one, register=r1, load_enable=r0_q, id=12)
  r2_d: () = register_write(computed, register=r2, load_enable=r1_q, id=13)
  literal_result: () = output_port(r1_q, name=literal_result, id=14)
  computed_result: () = output_port(r2_q, name=computed_result, id=15)
}

// OPTIONS: layout = "pipeline"
// EXPECT-SV: module shared_constants(
// EXPECT-SV:   input logic clk,
// EXPECT-SV:   input logic data,
// EXPECT-SV:   output logic literal_result,
// EXPECT-SV:   output logic computed_result
// EXPECT-SV: );
// EXPECT-SV:   // ===== Pipe stage 0:
// EXPECT-SV:   logic p0_one_comb;
// EXPECT-SV:   logic p0_unused_literal_consumer_comb;
// EXPECT-SV:   logic p0_different_comb;
// EXPECT-SV:   logic p0_computed_comb;
// EXPECT-SV:   logic p0_unused_computed_consumer_comb;
// EXPECT-SV:   assign p0_one_comb = 1'h1;
// EXPECT-SV:   assign p0_unused_literal_consumer_comb = ~p0_one_comb;
// EXPECT-SV:   assign p0_different_comb = 1'h0 != 1'h0;
// EXPECT-SV:   assign p0_computed_comb = ^p0_different_comb;
// EXPECT-SV:   assign p0_unused_computed_consumer_comb = ~p0_computed_comb;
// EXPECT-SV:
// EXPECT-SV:   // Registers for pipe stage 0:
// EXPECT-SV:   logic r0;
// EXPECT-SV:   always_ff @ (posedge clk) begin
// EXPECT-SV:     r0 <= data;
// EXPECT-SV:   end
// EXPECT-SV:
// EXPECT-SV:   // ===== Pipe stage 1:
// EXPECT-SV:
// EXPECT-SV:   // Registers for pipe stage 1:
// EXPECT-SV:   logic r1;
// EXPECT-SV:   always_ff @ (posedge clk) begin
// EXPECT-SV:     r1 <= r0 ? p0_one_comb : r1;
// EXPECT-SV:   end
// EXPECT-SV:
// EXPECT-SV:   // ===== Pipe stage 2:
// EXPECT-SV:
// EXPECT-SV:   // Registers for pipe stage 2:
// EXPECT-SV:   logic r2;
// EXPECT-SV:   always_ff @ (posedge clk) begin
// EXPECT-SV:     r2 <= r1 ? p0_computed_comb : r2;
// EXPECT-SV:   end
// EXPECT-SV:   assign literal_result = r1;
// EXPECT-SV:   assign computed_result = r2;
// EXPECT-SV: endmodule
