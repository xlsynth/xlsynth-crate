package pipeline_reset_enable_package

top block reset_enable_pipeline(clk: clock, rst_n: bits[1], enable: bits[1], data: bits[8], out: bits[8]) {
  #![reset(port="rst_n", asynchronous=true, active_low=true)]
  reg first(bits[8], reset_value=0)
  reg second(bits[8], reset_value=7)
  rst_n: bits[1] = input_port(name=rst_n, id=1)
  enable: bits[1] = input_port(name=enable, id=2)
  data: bits[8] = input_port(name=data, id=3)
  first_q: bits[8] = register_read(register=first, id=4)
  first_d: () = register_write(data, register=first, load_enable=enable, reset=rst_n, id=5)
  inverted: bits[8] = not(first_q, id=6)
  second_q: bits[8] = register_read(register=second, id=7)
  second_d: () = register_write(inverted, register=second, reset=rst_n, id=8)
  out: () = output_port(second_q, name=out, id=9)
}

// OPTIONS: layout = "pipeline"
// EXPECT-SV: module reset_enable_pipeline(
// EXPECT-SV:   input logic clk,
// EXPECT-SV:   input logic rst_n,
// EXPECT-SV:   input logic enable,
// EXPECT-SV:   input logic [7:0] data,
// EXPECT-SV:   output logic [7:0] out
// EXPECT-SV: );
// EXPECT-SV:   // ===== Pipe stage 0:
// EXPECT-SV:
// EXPECT-SV:   // Registers for pipe stage 0:
// EXPECT-SV:   logic [7:0] first;
// EXPECT-SV:   always_ff @ (posedge clk or negedge rst_n) begin
// EXPECT-SV:     if (!rst_n) begin
// EXPECT-SV:       first <= 8'h00;
// EXPECT-SV:     end else begin
// EXPECT-SV:       first <= enable ? data : first;
// EXPECT-SV:     end
// EXPECT-SV:   end
// EXPECT-SV:
// EXPECT-SV:   // ===== Pipe stage 1:
// EXPECT-SV:   logic [7:0] p1_inverted_comb;
// EXPECT-SV:   assign p1_inverted_comb = ~first;
// EXPECT-SV:
// EXPECT-SV:   // Registers for pipe stage 1:
// EXPECT-SV:   logic [7:0] second;
// EXPECT-SV:   always_ff @ (posedge clk or negedge rst_n) begin
// EXPECT-SV:     if (!rst_n) begin
// EXPECT-SV:       second <= 8'h07;
// EXPECT-SV:     end else begin
// EXPECT-SV:       second <= p1_inverted_comb;
// EXPECT-SV:     end
// EXPECT-SV:   end
// EXPECT-SV:   assign out = second;
// EXPECT-SV: endmodule
