package pipeline_priority_helpers_package

top block pipeline_priority_helpers(clk: clock, clz_8_4_offset_0: bits[8], out: bits[4]) {
  reg state(bits[8])
  clz_8_4_offset_0: bits[8] = input_port(name=clz_8_4_offset_0, id=3)
  state_write: () = register_write(clz_8_4_offset_0, register=state, id=4)
  state_read: bits[8] = register_read(register=state, id=5)
  called: bits[4] = ext_clz(state_read, offset=0, new_bit_count=4, id=6)
  direct: bits[4] = ext_clz(state_read, offset=0, new_bit_count=4, id=7)
  result: bits[4] = add(called, direct, id=8)
  out: () = output_port(result, name=out, id=9)
}

