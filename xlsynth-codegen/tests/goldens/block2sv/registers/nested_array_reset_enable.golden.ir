package nested_array_reset_enable_package

top block nested_array_reset_enable(clk: clock, rst: bits[1], enable: bits[1], data: bits[8][2][2], out: bits[8][2][2]) {
  #![reset(port="rst", asynchronous=false, active_low=false)]
  reg state(bits[8][2][2], reset_value=[[17, 34], [51, 68]])
  rst: bits[1] = input_port(name=rst, id=1)
  enable: bits[1] = input_port(name=enable, id=2)
  data: bits[8][2][2] = input_port(name=data, id=3)
  state_q: bits[8][2][2] = register_read(register=state, id=4)
  state_d: () = register_write(data, register=state, load_enable=enable, reset=rst, id=5)
  out: () = output_port(state_q, name=out, id=6)
}

// OPTIONS: layout = "pipeline"
// EXPECT-SV: module nested_array_reset_enable(
// EXPECT-SV:   input logic clk,
// EXPECT-SV:   input logic rst,
// EXPECT-SV:   input logic enable,
// EXPECT-SV:   input logic [1:0][1:0][7:0] data,
// EXPECT-SV:   output logic [1:0][1:0][7:0] out
// EXPECT-SV: );
// EXPECT-SV:   // ===== Pipe stage 0:
// EXPECT-SV:
// EXPECT-SV:   // Registers for pipe stage 0:
// EXPECT-SV:   logic [1:0][1:0][7:0] state;
// EXPECT-SV:   always_ff @ (posedge clk) begin
// EXPECT-SV:     if (rst) begin
// EXPECT-SV:       state <= {{8'h44, 8'h33}, {8'h22, 8'h11}};
// EXPECT-SV:     end else begin
// EXPECT-SV:       state <= enable ? data : state;
// EXPECT-SV:     end
// EXPECT-SV:   end
// EXPECT-SV:   assign out = state;
// EXPECT-SV: endmodule
