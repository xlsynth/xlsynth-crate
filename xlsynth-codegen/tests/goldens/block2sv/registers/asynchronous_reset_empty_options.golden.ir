package asynchronous_options_package

top block asynchronous_options(clk: clock, rst: bits[1], data: bits[8], out: bits[8]) {
  #![reset(port="rst", asynchronous=true, active_low=false)]
  reg state(bits[8], reset_value=0)
  rst: bits[1] = input_port(name=rst, id=1)
  data: bits[8] = input_port(name=data, id=2)
  state_q: bits[8] = register_read(register=state, id=3)
  state_d: () = register_write(data, register=state, reset=rst, id=4)
  out: () = output_port(state_q, name=out, id=5)
}

// OPTIONS: [register_codegen_options]
// OPTIONS: # Preserve native asynchronous-reset handling.
// EXPECT-SV: module asynchronous_options(
// EXPECT-SV:   input logic clk,
// EXPECT-SV:   input logic rst,
// EXPECT-SV:   input logic [7:0] data,
// EXPECT-SV:   output logic [7:0] out
// EXPECT-SV: );
// EXPECT-SV:   logic [7:0] state;
// EXPECT-SV:   always_ff @ (posedge clk or posedge rst) begin
// EXPECT-SV:     if (rst) begin
// EXPECT-SV:       state <= 8'h00;
// EXPECT-SV:     end else begin
// EXPECT-SV:       state <= data;
// EXPECT-SV:     end
// EXPECT-SV:   end
// EXPECT-SV:   assign out = state;
// EXPECT-SV: endmodule
