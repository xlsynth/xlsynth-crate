package accumulator_package

top block accumulator(clk: clock, data: bits[16], out: bits[16]) {
  reg total(bits[16])
  data: bits[16] = input_port(name=data, id=1)
  total_q: bits[16] = register_read(register=total, id=2)
  next_total: bits[16] = add(total_q, data, id=3)
  total_d: () = register_write(next_total, register=total, id=4)
  out: () = output_port(total_q, name=out, id=5)
}

// OPTIONS: layout = "none"
// EXPECT-SV: module accumulator(
// EXPECT-SV:   input logic clk,
// EXPECT-SV:   input logic [15:0] data,
// EXPECT-SV:   output logic [15:0] out
// EXPECT-SV: );
// EXPECT-SV:   logic [15:0] total;
// EXPECT-SV:   logic [15:0] next_total;
// EXPECT-SV:   assign next_total = total + data;
// EXPECT-SV:   always_ff @ (posedge clk) begin
// EXPECT-SV:     total <= next_total;
// EXPECT-SV:   end
// EXPECT-SV:   assign out = total;
// EXPECT-SV: endmodule
