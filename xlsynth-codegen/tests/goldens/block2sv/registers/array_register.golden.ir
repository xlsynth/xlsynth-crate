// EXPECT-SV: module array_register(
// EXPECT-SV:   input logic clk,
// EXPECT-SV:   input logic [1:0][7:0] data,
// EXPECT-SV:   output logic [1:0][7:0] out
// EXPECT-SV: );
// EXPECT-SV:   logic [1:0][7:0] values;
