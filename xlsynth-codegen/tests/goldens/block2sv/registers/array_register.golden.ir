package array_register_package

top block array_register(clk: clock, data: bits[8][2], out: bits[8][2]) {
  reg values(bits[8][2])
  data: bits[8][2] = input_port(name=data, id=1)
  values_q: bits[8][2] = register_read(register=values, id=2)
  values_d: () = register_write(data, register=values, id=3)
  out: () = output_port(values_q, name=out, id=4)
}

