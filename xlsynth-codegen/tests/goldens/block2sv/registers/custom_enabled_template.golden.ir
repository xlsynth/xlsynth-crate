package custom_enabled_package

top block custom_enabled(clk: clock, enable: bits[1], data: bits[8], out: bits[8]) {
  reg state(bits[8])
  enable: bits[1] = input_port(name=enable, id=1)
  data: bits[8] = input_port(name=data, id=2)
  state_q: bits[8] = register_read(register=state, id=3)
  state_d: () = register_write(data, register=state, load_enable=enable, id=4)
  out: () = output_port(state_q, name=out, id=5)
}

// OPTIONS: [register_codegen_options]
// OPTIONS: reg_with_en_template = "always_ff @(posedge {{clock}}) if ({{en}}) {{reg}} <= {{next}};"
// EXPECT-SV: module custom_enabled(
// EXPECT-SV:   input logic clk,
// EXPECT-SV:   input logic enable,
// EXPECT-SV:   input logic [7:0] data,
// EXPECT-SV:   output logic [7:0] out
// EXPECT-SV: );
// EXPECT-SV:   logic [7:0] state;
// EXPECT-SV:   always_ff @(posedge clk) if (enable) state <= data;
// EXPECT-SV:   assign out = state;
// EXPECT-SV: endmodule
