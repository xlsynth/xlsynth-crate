package custom_reset_enable_package

top block custom_reset_enable(clk: clock, reset: bits[1], enable: bits[1], data: bits[8], out: bits[8]) {
  #![reset(port="reset", asynchronous=false, active_low=false)]
  reg state(bits[8], reset_value=5)
  reset: bits[1] = input_port(name=reset, id=1)
  enable: bits[1] = input_port(name=enable, id=2)
  data: bits[8] = input_port(name=data, id=3)
  state_q: bits[8] = register_read(register=state, id=4)
  state_d: () = register_write(data, register=state, load_enable=enable, reset=reset, id=5)
  out: () = output_port(state_q, name=out, id=6)
}

// OPTIONS: [register_codegen_options]
// OPTIONS: reg_with_reset_with_en_template = "always_ff @(posedge {{clock}}) if ({{reset}}) {{reg}} <= {{reset_value}}; else if ({{en}}) {{reg}} <= {{next}};"
// EXPECT-SV: module custom_reset_enable(
// EXPECT-SV:   input logic clk,
// EXPECT-SV:   input logic reset,
// EXPECT-SV:   input logic enable,
// EXPECT-SV:   input logic [7:0] data,
// EXPECT-SV:   output logic [7:0] out
// EXPECT-SV: );
// EXPECT-SV:   logic [7:0] state;
// EXPECT-SV:   always_ff @(posedge clk) if (reset) state <= 8'h05; else if (enable) state <= data;
// EXPECT-SV:   assign out = state;
// EXPECT-SV: endmodule
