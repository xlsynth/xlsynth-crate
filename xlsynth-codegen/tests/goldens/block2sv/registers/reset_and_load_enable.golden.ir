package reset_enable_package

top block reset_and_enable(clk: clock, rst_n: bits[1], enable: bits[1], data: bits[8], out: bits[8]) {
  #![reset(port="rst_n", asynchronous=false, active_low=true)]
  reg state(bits[8], reset_value=3)
  rst_n: bits[1] = input_port(name=rst_n, id=1)
  enable: bits[1] = input_port(name=enable, id=2)
  data: bits[8] = input_port(name=data, id=3)
  state_q: bits[8] = register_read(register=state, id=4)
  state_d: () = register_write(data, register=state, load_enable=enable, reset=rst_n, id=5)
  out: () = output_port(state_q, name=out, id=6)
}

// OPTIONS: # BlockCodegenOptions defaults
// EXPECT-SV: module reset_and_enable(
// EXPECT-SV:   input logic clk,
// EXPECT-SV:   input logic rst_n,
// EXPECT-SV:   input logic enable,
// EXPECT-SV:   input logic [7:0] data,
// EXPECT-SV:   output logic [7:0] out
// EXPECT-SV: );
// EXPECT-SV:   logic [7:0] state;
// EXPECT-SV:   always_ff @ (posedge clk) begin
// EXPECT-SV:     if (!rst_n) begin
// EXPECT-SV:       state <= 8'h03;
// EXPECT-SV:     end else begin
// EXPECT-SV:       state <= enable ? data : state;
// EXPECT-SV:     end
// EXPECT-SV:   end
// EXPECT-SV:   assign out = state;
// EXPECT-SV: endmodule
