package asynchronous_low_package

top block asynchronous_low(clk: clock, rst_n: bits[1], data: bits[16], out: bits[16]) {
  #![reset(port="rst_n", asynchronous=true, active_low=true)]
  reg state(bits[16], reset_value=255)
  rst_n: bits[1] = input_port(name=rst_n, id=1)
  data: bits[16] = input_port(name=data, id=2)
  state_q: bits[16] = register_read(register=state, id=3)
  state_d: () = register_write(data, register=state, reset=rst_n, id=4)
  out: () = output_port(state_q, name=out, id=5)
}

// OPTIONS: # BlockCodegenOptions defaults
// EXPECT-SV: module asynchronous_low(
// EXPECT-SV:   input logic clk,
// EXPECT-SV:   input logic rst_n,
// EXPECT-SV:   input logic [15:0] data,
// EXPECT-SV:   output logic [15:0] out
// EXPECT-SV: );
// EXPECT-SV:   logic [15:0] state;
// EXPECT-SV:   always_ff @ (posedge clk or negedge rst_n) begin
// EXPECT-SV:     if (!rst_n) begin
// EXPECT-SV:       state <= 16'h00ff;
// EXPECT-SV:     end else begin
// EXPECT-SV:       state <= data;
// EXPECT-SV:     end
// EXPECT-SV:   end
// EXPECT-SV:   assign out = state;
// EXPECT-SV: endmodule
