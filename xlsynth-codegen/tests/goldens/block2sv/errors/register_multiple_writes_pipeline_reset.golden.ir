package multiple_pipeline_writes_package

top block multiple_pipeline_writes(clk: clock, reset: bits[1], valid: bits[1], choice: bits[1], first: bits[8], second: bits[8], out: bits[8]) {
  #![reset(port="reset", asynchronous=false, active_low=false)]
  reg state(bits[8], reset_value=13)
  reg output_stage(bits[8], reset_value=0)
  reset: bits[1] = input_port(name=reset, id=1)
  valid: bits[1] = input_port(name=valid, id=2)
  choice: bits[1] = input_port(name=choice, id=3)
  first: bits[8] = input_port(name=first, id=4)
  second: bits[8] = input_port(name=second, id=5)
  not_choice: bits[1] = not(choice, id=6)
  first_enable: bits[1] = and(valid, not_choice, id=7)
  second_enable: bits[1] = and(valid, choice, id=8)
  state_q: bits[8] = register_read(register=state, id=9)
  first_write: () = register_write(first, register=state, load_enable=first_enable, reset=reset, id=10)
  second_write: () = register_write(second, register=state, load_enable=second_enable, reset=reset, id=11)
  output_q: bits[8] = register_read(register=output_stage, id=12)
  output_write: () = register_write(state_q, register=output_stage, reset=reset, id=13)
  out: () = output_port(output_q, name=out, id=14)
}

// OPTIONS: layout = "pipeline"
// EXPECT-ERROR: register `state` in block `multiple_pipeline_writes` requires exactly one write, found 2
