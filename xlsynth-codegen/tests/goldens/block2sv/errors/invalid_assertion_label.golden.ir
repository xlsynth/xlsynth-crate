package invalid_assertion_label_package

top block invalid_assertion_label(clk: clock, valid: bits[1], out: bits[1]) {
  valid: bits[1] = input_port(name=valid, id=1)
  token: token = after_all(id=2)
  checked: token = assert(token, valid, message="input must be valid", label="invalid-label", id=3)
  out: () = output_port(valid, name=out, id=4)
}

