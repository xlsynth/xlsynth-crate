package combinational_child_feedback_package

block feedthrough(data: bits[8], out: bits[8]) {
  data: bits[8] = input_port(name=data, id=1)
  out: () = output_port(data, name=out, id=2)
}

top block cyclic_parent(out: bits[8]) {
  instantiation child(block=feedthrough, kind=block)
  child_output: bits[8] = instantiation_output(instantiation=child, port_name=out, id=3)
  child_input: () = instantiation_input(child_output, instantiation=child, port_name=data, id=4)
  out: () = output_port(child_output, name=out, id=5)
}

// OPTIONS: # BlockCodegenOptions defaults
// EXPECT-ERROR: block `cyclic_parent` contains a combinational cycle through its block hierarchy at node `child_output`
