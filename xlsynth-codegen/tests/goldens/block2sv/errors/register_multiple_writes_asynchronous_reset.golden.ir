package multiple_asynchronous_writes_package

top block multiple_asynchronous_writes(clk: clock, rst_n: bits[1], valid: bits[1], choice: bits[1], first: bits[8], second: bits[8], out: bits[8]) {
  #![reset(port="rst_n", asynchronous=true, active_low=true)]
  reg state(bits[8], reset_value=27)
  rst_n: bits[1] = input_port(name=rst_n, id=1)
  valid: bits[1] = input_port(name=valid, id=2)
  choice: bits[1] = input_port(name=choice, id=3)
  first: bits[8] = input_port(name=first, id=4)
  second: bits[8] = input_port(name=second, id=5)
  not_choice: bits[1] = not(choice, id=6)
  first_enable: bits[1] = and(valid, not_choice, id=7)
  second_enable: bits[1] = and(valid, choice, id=8)
  state_q: bits[8] = register_read(register=state, id=9)
  first_write: () = register_write(first, register=state, load_enable=first_enable, reset=rst_n, id=10)
  second_write: () = register_write(second, register=state, load_enable=second_enable, reset=rst_n, id=11)
  out: () = output_port(state_q, name=out, id=12)
}

