package unresolved_template_package

#[ffi_proto("""code_template: "external_unit {fn} (.data({value}), .missing({unconnected}), .out({return}));"
""")]
fn external_unit(value: bits[8] id=1) -> bits[8] {
  ret value: bits[8] = param(name=value, id=1)
}

top block unresolved_template(data: bits[8], out: bits[8]) {
  instantiation external_instance(foreign_function=external_unit, kind=extern)
  data: bits[8] = input_port(name=data, id=2)
  connected_input: () = instantiation_input(data, instantiation=external_instance, port_name=value, id=3)
  connected_output: bits[8] = instantiation_output(instantiation=external_instance, port_name=return, id=4)
  out: () = output_port(connected_output, name=out, id=5)
}

// OPTIONS: # BlockCodegenOptions defaults
// EXPECT-ERROR: external instance `external_instance` leaves ffi_proto placeholder `{unconnected}` unresolved
