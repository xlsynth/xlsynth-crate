package unsafe_reset_template_package

top block unsafe_reset_template(clk: clock, rst: bits[1], data: bits[8], out: bits[8]) {
  #![reset(port="rst", asynchronous=true, active_low=false)]
  reg state(bits[8], reset_value=0)
  rst: bits[1] = input_port(name=rst, id=1)
  data: bits[8] = input_port(name=data, id=2)
  state_q: bits[8] = register_read(register=state, id=3)
  state_d: () = register_write(data, register=state, reset=rst, id=4)
  out: () = output_port(state_q, name=out, id=5)
}

// OPTIONS: [register_codegen_options]
// OPTIONS: reg_with_reset_template = "always_ff @(posedge {{clock}}) if ({{reset}}) {{reg}} <= {{reset_value}}; else {{reg}} <= {{next}};"
// EXPECT-ERROR: block `unsafe_reset_template` has asynchronous reset; custom reset-register templates cannot guarantee the required reset edge semantics
