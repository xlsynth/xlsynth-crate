package feedback_pipeline_package

top block feedback_pipeline(clk: clock, data: bits[8], out: bits[8]) {
  reg state(bits[8])
  data: bits[8] = input_port(name=data, id=1)
  state_q: bits[8] = register_read(register=state, id=2)
  sum: bits[8] = add(state_q, data, id=3)
  state_d: () = register_write(sum, register=state, id=4)
  out: () = output_port(state_q, name=out, id=5)
}

// OPTIONS: layout = "pipeline"
// EXPECT-ERROR: block `feedback_pipeline` cannot use layout=pipeline: register feedback or uneven register layering prevents feed-forward stage reconstruction; use layout=none
