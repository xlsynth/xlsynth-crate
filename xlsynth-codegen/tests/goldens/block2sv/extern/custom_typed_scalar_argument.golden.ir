package extern_scalar

#[ffi_proto("""code_template: "assign {return} = {data}[1];"
""")]
fn bit_one(data: bits[8] id=1) -> bits[1] {
  ret bit_slice.2: bits[1] = bit_slice(data, start=1, width=1, id=2)
}

top block typed_scalar_argument(data: bits[8], selected: bits[1]) {
  instantiation extract(foreign_function=bit_one, kind=extern)
  data: bits[8] = input_port(name=data, sv_type="types::input_t", id=3)
  instantiation_input.4: () = instantiation_input(data, instantiation=extract, port_name=data, id=4)
  bit_one_result: bits[1] = instantiation_output(instantiation=extract, port_name=return, id=5)
  selected: () = output_port(bit_one_result, name=selected, id=6)
}

