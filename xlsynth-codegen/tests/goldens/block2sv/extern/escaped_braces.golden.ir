package escaped_template_package

#[ffi_proto("""code_template: "assign {return} = {{{value}, {value}}};"
""")]
fn external_duplicate(value: bits[8] id=1) -> bits[16] {
  ret result: bits[16] = concat(value, value, id=2)
}

top block escaped_template(data: bits[8], out: bits[16]) {
  instantiation external_instance(foreign_function=external_duplicate, kind=extern)
  data: bits[8] = input_port(name=data, id=3)
  connected_input: () = instantiation_input(data, instantiation=external_instance, port_name=value, id=4)
  connected_output: bits[16] = instantiation_output(instantiation=external_instance, port_name=return, id=5)
  out: () = output_port(connected_output, name=out, id=6)
}

// OPTIONS: # BlockCodegenOptions defaults
// EXPECT-SV: module escaped_template(
// EXPECT-SV:   input logic [7:0] data,
// EXPECT-SV:   output logic [15:0] out
// EXPECT-SV: );
// EXPECT-SV:   logic [15:0] connected_output;
// EXPECT-SV:   assign out = connected_output;
// EXPECT-SV:   assign connected_output = {data, data};
// EXPECT-SV: endmodule
