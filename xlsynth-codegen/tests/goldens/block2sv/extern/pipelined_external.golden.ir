package pipelined_external_package

#[ffi_proto("""code_template: "assign {return} = ~{value};"
""")]
fn external_invert(value: bits[8] id=1) -> bits[8] {
  ret result: bits[8] = not(value, id=2)
}

top block external_pipeline(clk: clock, data: bits[8], out: bits[8]) {
  instantiation external_instance(foreign_function=external_invert, kind=extern)
  reg input_stage(bits[8])
  reg output_stage(bits[8])
  data: bits[8] = input_port(name=data, id=3)
  input_q: bits[8] = register_read(register=input_stage, id=4)
  input_d: () = register_write(data, register=input_stage, id=5)
  connected_input: () = instantiation_input(input_q, instantiation=external_instance, port_name=value, id=6)
  connected_output: bits[8] = instantiation_output(instantiation=external_instance, port_name=return, id=7)
  output_q: bits[8] = register_read(register=output_stage, id=8)
  output_d: () = register_write(connected_output, register=output_stage, id=9)
  out: () = output_port(output_q, name=out, id=10)
}

// OPTIONS: layout = "pipeline"
// EXPECT-SV: module external_pipeline(
// EXPECT-SV:   input logic clk,
// EXPECT-SV:   input logic [7:0] data,
// EXPECT-SV:   output logic [7:0] out
// EXPECT-SV: );
// EXPECT-SV:   // ===== Pipe stage 0:
// EXPECT-SV:
// EXPECT-SV:   // Registers for pipe stage 0:
// EXPECT-SV:   logic [7:0] input_stage;
// EXPECT-SV:   always_ff @ (posedge clk) begin
// EXPECT-SV:     input_stage <= data;
// EXPECT-SV:   end
// EXPECT-SV:
// EXPECT-SV:   // ===== Pipe stage 1:
// EXPECT-SV:   logic [7:0] connected_output;
// EXPECT-SV:
// EXPECT-SV:   // Registers for pipe stage 1:
// EXPECT-SV:   logic [7:0] output_stage;
// EXPECT-SV:   always_ff @ (posedge clk) begin
// EXPECT-SV:     output_stage <= connected_output;
// EXPECT-SV:   end
// EXPECT-SV:   assign out = output_stage;
// EXPECT-SV:
// EXPECT-SV:   // ===== Instantiations
// EXPECT-SV:   assign connected_output = ~input_stage;
// EXPECT-SV: endmodule
