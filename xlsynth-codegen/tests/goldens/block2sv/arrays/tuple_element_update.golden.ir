top block update_tuple(data: (bits[4], bits[8])[2], index: bits[2], value: (bits[4], bits[8]), out: (bits[4], bits[8])[2]) {
  data: (bits[4], bits[8])[2] = input_port(name=data, id=1)
  index: bits[2] = input_port(name=index, id=2)
  value: (bits[4], bits[8]) = input_port(name=value, id=3)
  updated: (bits[4], bits[8])[2] = array_update(data, value, indices=[index], id=4)
  out: () = output_port(updated, name=out, id=5)
}

