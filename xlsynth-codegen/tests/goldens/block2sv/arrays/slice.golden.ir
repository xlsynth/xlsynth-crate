package array_slice_package

top block slice_array(data: bits[8][4], start: bits[3], out: bits[8][2]) {
  data: bits[8][4] = input_port(name=data, id=1)
  start: bits[3] = input_port(name=start, id=2)
  selected: bits[8][2] = array_slice(data, start, width=2, id=3)
  out: () = output_port(selected, name=out, id=4)
}

