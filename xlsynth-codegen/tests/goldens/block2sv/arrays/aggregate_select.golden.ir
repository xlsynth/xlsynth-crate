package aggregate_selection_package

top block select_array(selector: bits[1], first: bits[8][3], second: bits[8][3], out: bits[8][3]) {
  selector: bits[1] = input_port(name=selector, id=1)
  first: bits[8][3] = input_port(name=first, id=2)
  second: bits[8][3] = input_port(name=second, id=3)
  selected: bits[8][3] = sel(selector, cases=[first, second], id=4)
  out: () = output_port(selected, name=out, id=5)
}

