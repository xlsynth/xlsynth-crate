package subarray_update_package

top block update_subarray(data: bits[8][3][2], row: bits[2], value: bits[8][3], out: bits[8][3][2]) {
  data: bits[8][3][2] = input_port(name=data, id=1)
  row: bits[2] = input_port(name=row, id=2)
  value: bits[8][3] = input_port(name=value, id=3)
  updated: bits[8][3][2] = array_update(data, value, indices=[row], id=4)
  out: () = output_port(updated, name=out, id=5)
}

