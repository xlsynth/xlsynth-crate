package array_concat_package

top block concat_arrays(first: bits[8][2], second: bits[8][3], out: bits[8][5]) {
  first: bits[8][2] = input_port(name=first, id=1)
  second: bits[8][3] = input_port(name=second, id=2)
  combined: bits[8][5] = array_concat(first, second, id=3)
  out: () = output_port(combined, name=out, id=4)
}

