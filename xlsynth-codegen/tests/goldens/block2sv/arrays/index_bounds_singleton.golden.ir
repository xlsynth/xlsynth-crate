package index_bounds_singleton_package

top block index_bounds_singleton(data: bits[8][1], index: bits[4], out: bits[8]) {
  data: bits[8][1] = input_port(name=data, id=1)
  index: bits[4] = input_port(name=index, id=2)
  selected: bits[8] = array_index(data, indices=[index], id=3)
  out: () = output_port(selected, name=out, id=4)
}

// OPTIONS: array_index_bounds_checking = true
// EXPECT-SV: module index_bounds_singleton(
// EXPECT-SV:   input logic [0:0][7:0] data,
// EXPECT-SV:   input logic [3:0] index,
// EXPECT-SV:   output logic [7:0] out
// EXPECT-SV: );
// EXPECT-SV:   logic [7:0] selected;
// EXPECT-SV:   assign selected = data[index < 4'h1 ? index : 4'h0];
// EXPECT-SV:   assign out = selected;
// EXPECT-SV: endmodule
