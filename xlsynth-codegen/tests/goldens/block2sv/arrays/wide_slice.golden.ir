package wide_array_slice_package

top block wide_slice(data: bits[8][3], start: bits[3], out: bits[8][8]) {
  data: bits[8][3] = input_port(name=data, id=1)
  start: bits[3] = input_port(name=start, id=2)
  selected: bits[8][8] = array_slice(data, start, width=8, id=3)
  out: () = output_port(selected, name=out, id=4)
}

