// EXPECT-SV:   output types::output_t out
// EXPECT-SV: );
// EXPECT-SV:   // ===== Pipe stage 0:
// EXPECT-SV:   logic [1:0][3:0] p0_data_comb;
// EXPECT-SV:   logic [1:0][3:0] p0_updated_comb;
// EXPECT-SV:   assign p0_data_comb = data;
// EXPECT-SV:   for (genvar __i0 = 0; __i0 < 2; __i0 = __i0 + 1) begin : gen__p0_updated_comb_0
