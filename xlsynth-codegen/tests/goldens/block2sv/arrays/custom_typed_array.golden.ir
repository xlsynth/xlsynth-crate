package custom_typed_array_package

top block custom_typed_array(data: bits[4][2], index: bits[2], replacement: bits[4], out: bits[4][2]) {
  data: bits[4][2] = input_port(name=data, sv_type="types::input_t", id=1)
  index: bits[2] = input_port(name=index, id=2)
  replacement: bits[4] = input_port(name=replacement, id=3)
  updated: bits[4][2] = array_update(data, replacement, indices=[index], id=4)
  out: () = output_port(updated, name=out, sv_type="types::output_t", id=5)
}

