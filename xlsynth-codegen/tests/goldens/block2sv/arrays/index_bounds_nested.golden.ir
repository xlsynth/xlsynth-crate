package index_bounds_nested_package

top block index_bounds_nested(data: bits[8][3][2], row: bits[3], column: bits[4], row_out: bits[8][3], element_out: bits[8]) {
  data: bits[8][3][2] = input_port(name=data, id=1)
  row: bits[3] = input_port(name=row, id=2)
  column: bits[4] = input_port(name=column, id=3)
  selected_row: bits[8][3] = array_index(data, indices=[row], id=4)
  selected_element: bits[8] = array_index(selected_row, indices=[column], id=5)
  row_out: () = output_port(selected_row, name=row_out, id=6)
  element_out: () = output_port(selected_element, name=element_out, id=7)
}

// OPTIONS: array_index_bounds_checking = true
// EXPECT-SV: module index_bounds_nested(
// EXPECT-SV:   input logic [1:0][2:0][7:0] data,
// EXPECT-SV:   input logic [2:0] row,
// EXPECT-SV:   input logic [3:0] column,
// EXPECT-SV:   output logic [2:0][7:0] row_out,
// EXPECT-SV:   output logic [7:0] element_out
// EXPECT-SV: );
// EXPECT-SV:   logic [2:0][7:0] selected_row;
// EXPECT-SV:   logic [7:0] selected_element;
// EXPECT-SV:   assign selected_row = data[row < 3'h2 ? row : 3'h1];
// EXPECT-SV:   assign selected_element = selected_row[column < 4'h3 ? column : 4'h2];
// EXPECT-SV:   assign row_out = selected_row;
// EXPECT-SV:   assign element_out = selected_element;
// EXPECT-SV: endmodule
