package random_block_package

top block random_block_0(clk: clock, in0: bits[64], in1: bits[64], out: bits[1]) {
  reg r0(bits[64])
  reg r1(bits[64])
  reg r2(bits[64])
  in0: bits[64] = input_port(name=in0, id=1)
  in1: bits[64] = input_port(name=in1, id=2)
  r0_q: bits[64] = register_read(register=r0, id=3)
  r1_q: bits[64] = register_read(register=r1, id=4)
  r2_q: bits[64] = register_read(register=r2, id=5)
  smul.6: bits[128] = smul(in1, in1, id=6)
  umul.7: bits[128] = umul(smul.6, smul.6, id=7)
  sgt.8: bits[1] = sgt(smul.6, umul.7, id=8)
  sgt.9: bits[1] = sgt(smul.6, umul.7, id=9)
  literal.10: bits[19] = literal(value=13304, id=10)
  decode.11: bits[55] = decode(literal.10, width=55, id=11)
  xor_reduce.12: bits[1] = xor_reduce(sgt.8, id=12)
  nor.13: bits[19] = nor(literal.10, literal.10, literal.10, id=13)
  xor_reduce.14: bits[1] = xor_reduce(sgt.8, id=14)
  gate.15: bits[19] = gate(sgt.8, literal.10, id=15)
  ule.16: bits[1] = ule(r0_q, r0_q, id=16)
  xor.17: bits[64] = xor(r0_q, id=17)
  r0_d: () = register_write(in1, register=r0, load_enable=xor_reduce.12, id=18)
  r1_d: () = register_write(xor.17, register=r1, id=19)
  r2_d: () = register_write(r1_q, register=r2, id=20)
  out: () = output_port(sgt.9, name=out, id=21)
}
