package random_block_package

top block random_block_0(clk: clock, in0: bits[32], in1: bits[32], out: bits[63]) {
  reg r0(bits[32])
  reg r1(bits[32])
  in0: bits[32] = input_port(name=in0, id=1)
  in1: bits[32] = input_port(name=in1, id=2)
  r0_q: bits[32] = register_read(register=r0, id=3)
  r1_q: bits[32] = register_read(register=r1, id=4)
  bit_slice_update.5: bits[32] = bit_slice_update(in0, in1, in0, id=5)
  ugt.6: bits[1] = ugt(bit_slice_update.5, in0, id=6)
  sel.7: bits[32] = sel(in0, cases=[in1, bit_slice_update.5, bit_slice_update.5, bit_slice_update.5], default=bit_slice_update.5, id=7)
  umul.8: bits[63] = umul(in1, bit_slice_update.5, id=8)
  sle.9: bits[1] = sle(umul.8, umul.8, id=9)
  and_reduce.10: bits[1] = and_reduce(umul.8, id=10)
  umul.11: bits[8] = umul(ugt.6, bit_slice_update.5, id=11)
  gate.12: bits[63] = gate(and_reduce.10, umul.8, id=12)
  sub.13: bits[32] = sub(in0, in0, id=13)
  r0_d: () = register_write(sel.7, register=r0, load_enable=and_reduce.10, id=14)
  r1_d: () = register_write(r0_q, register=r1, id=15)
  out: () = output_port(umul.8, name=out, id=16)
}
