import Lean

/-!
Emit the sorted Rust table of top-level names that own declarations after
`import Std`.

Regenerate the table whenever `lean/lean-toolchain` or the imports of the
generated `ReadableTypes.lean` module change. From the repository root, run:

```
/path/to/pinned/lean -E error --run xlsynth-lean/tools/generate_std_roots.lean \
  > xlsynth-lean/src/block/readable/std_roots.rs
```
-/

open Lean

unsafe def main : IO Unit := do
  let env <- importModules #[{ module := `Std }] {}
  let roots := env.constants.toList.foldl (fun roots (name, _) =>
    if name.getNumParts > 1 then
      let root := name.getRoot.toString
      if roots.contains root then roots else root :: roots
    else
      roots) []
  let roots := roots.mergeSort fun a b => compare a b == .lt
  IO.println "// @generated by xlsynth-lean/tools/generate_std_roots.lean; do not edit."
  IO.println "&["
  for root in roots do
    IO.println s!"    {repr root},"
  IO.println "]"
