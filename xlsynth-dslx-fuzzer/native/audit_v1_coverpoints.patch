 static thread_local int audit_alternate_depth = 0;
+
+// Restrict effect probes to an inline DSLX call whose resolved callee can emit
+// a token. A name referring to an already evaluated call is a separate control.
+static bool IsAuditTokenCall(const Expr* expr, const TypeInfo& type_info) {
+  auto* call = dynamic_cast<const Invocation*>(expr);
+  if (call == nullptr) {
+    return false;
+  }
+  auto data = type_info.GetInvocationData(call);
+  return data.has_value() && data->callee() != nullptr &&
+         type_info.GetRequiresImplicitToken(*data->callee()).value_or(false);
+}

