package shift_choices

top fn main(x: bits[4] id=1, en: bits[1] id=2, p: bits[1] id=3, q: bits[1] id=4) -> bits[4] {
  bit_slice.15: bits[1] = bit_slice(x, start=0, width=1, id=15)
  literal.41: bits[1] = literal(value=0, id=41)
  bit_slice.12: bits[2] = bit_slice(x, start=0, width=2, id=12)
  concat.45: bits[2] = concat(bit_slice.15, literal.41, id=45)
  sel.33: bits[2] = sel(q, cases=[bit_slice.12, concat.45], id=33)
  concat.47: bits[3] = concat(sel.33, literal.41, id=47)
  bit_slice.19: bits[3] = bit_slice(x, start=0, width=3, id=19)
  sel.39: bits[3] = sel(p, cases=[concat.47, bit_slice.19], id=39)
  concat.49: bits[4] = concat(sel.39, literal.41, id=49)
  ret sel.23: bits[4] = sel(en, cases=[x, concat.49], id=23)
}

